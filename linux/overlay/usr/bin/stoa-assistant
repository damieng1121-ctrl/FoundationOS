    "Build me a Pomodoro timer",
    "Make a monthly budget tracker",
    "Install Google Chrome",
    "How much disk space do I have?",
    "Build a to-do list with priorities",
    "Turn the volume down to 30%",
]

TOOL_LABELS = {
    "build_app": ("Building your app", "Built"),
    "list_apps": ("Checking your apps", "Checked your apps"),
    "read_app": ("Reading the app", "Read the app"),
    "delete_app": ("Deleting the app", "Done"),
    "search_software": ("Searching the Stoa Store", "Searched the Store"),
    "install_software": ("Installing", "Installed"),
    "open_app": ("Opening", "Opened"),
    "change_setting": ("Changing a setting", "Setting changed"),
    "get_system_info": ("Checking your system", "Checked your system"),
}


def markup(text):
    """Very small Markdown -> Pango converter: **bold**, `code`, headings and bullets."""
    t = html.escape(text, quote=False)
    t = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", t)
    t = re.sub(r"`([^`]+)`", r"<tt>\1</tt>", t)
    t = re.sub(r"(?m)^#{1,6}\s*(.+)$", r"<b>\1</b>", t)
    t = re.sub(r"(?m)^\s*[-*]\s+", "• ", t)
    return t


def ui_call(fn):
    """Decorator: run a UI callback on the GTK main loop (callbacks arrive from the agent thread)."""
    def wrap(*a, **k):
        GLib.idle_add(lambda: (fn(*a, **k), False)[1])
    return wrap


class Panel(Gtk.Window):
    def __init__(self, app):
        super().__init__(application=app)
        self.set_title("Stoa AI")
        theme.transparent(self)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "stoa-ai")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.TOP)
        for e, m in ((GtkLayerShell.Edge.TOP, 8), (GtkLayerShell.Edge.BOTTOM, 68), (GtkLayerShell.Edge.RIGHT, 8)):
            GtkLayerShell.set_anchor(self, e, True)
            GtkLayerShell.set_margin(self, e, m)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
        self.set_size_request(440, -1)
        self.connect("key-press-event", self._key)

        from agent import Agent
        self.agent = Agent(self)

        root = theme.css(Gtk.Box(orientation=Gtk.Orientation.VERTICAL), "ai-panel")
        self.add(root)
        root.pack_start(self._header(), False, False, 0)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        root.pack_start(self.stack, True, True, 0)
        self.stack.add_named(self._setup_page(), "setup")
        self.stack.add_named(self._chat_page(), "chat")
        self.show_all()
        self._enter()

    # ---------------------------------------------------------------- layout
    def _header(self):
        h = theme.css(Gtk.Box(spacing=12), "ai-head")
        pb = GdkPixbuf.Pixbuf.new_from_file_at_size("/usr/share/stoa/logo-round-96.png", 36, 36)
        h.pack_start(Gtk.Image.new_from_pixbuf(pb), False, False, 0)
        t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        t.pack_start(theme.css(Gtk.Label(label="Stoa AI", xalign=0), "ai-title"), False, False, 0)
        self.subtitle = theme.css(Gtk.Label(label="Ask for anything, or ask it to build an app", xalign=0,
                                            ellipsize=Pango.EllipsizeMode.END, max_width_chars=36), "ai-sub")
        t.pack_start(self.subtitle, False, False, 0)
        h.pack_start(t, True, True, 0)
        menu = theme.css(Gtk.Button(label="⋯"), "fs-power-btn")
        menu.connect("clicked", self._menu)
        h.pack_end(menu, False, False, 0)
        close = theme.css(Gtk.Button(label="✕"), "fs-power-btn")
        close.connect("clicked", lambda *_: self.hide())
        h.pack_end(close, False, False, 0)
        return h

    def _setup_page(self):
        from agent import PROVIDERS
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(22)
        box.pack_start(theme.css(Gtk.Label(label="Connect Stoa AI", xalign=0), "fs-h1"), False, False, 0)
        box.pack_start(theme.css(Gtk.Label(
            label="Choose the AI you'd like Stoa to use. Any of them can build apps, install software and "
                  "change settings for you. Paste an API key, or sign in to OpenRouter or Hugging Face to use "
                  "open models without one. Keys stay on this computer.",
            xalign=0, wrap=True, max_width_chars=46), "fs-muted"), False, False, 0)

        self.provider_combo = Gtk.ComboBoxText()
        for pid, p in PROVIDERS.items():
            self.provider_combo.append(pid, p["label"])
        self.provider_combo.connect("changed", self._provider_changed)
        box.pack_start(self.provider_combo, False, False, 0)

        self.url_entry = theme.css(Gtk.Entry(placeholder_text="Service address, e.g. https://openrouter.ai/api/v1"),
                                   "ai-input")
        box.pack_start(self.url_entry, False, False, 0)
        self.key_entry = theme.css(Gtk.Entry(visibility=False), "ai-input")
        self.key_entry.connect("activate", self._save_key)
        box.pack_start(self.key_entry, False, False, 0)

        mrow = Gtk.Box(spacing=8)
        self.model_combo = Gtk.ComboBoxText.new_with_entry()
        self.model_combo.get_child().set_placeholder_text("Model")
        mrow.pack_start(self.model_combo, True, True, 0)
        self.load_btn = theme.css(Gtk.Button(label="Load models"), "ai-deny")
        self.load_btn.connect("clicked", self._load_models)
        mrow.pack_start(self.load_btn, False, False, 0)
        box.pack_start(mrow, False, False, 0)
        self.model_row = mrow

        self.privacy = theme.css(Gtk.Label(xalign=0, wrap=True, max_width_chars=46), "fs-muted")
        box.pack_start(self.privacy, False, False, 0)
        row = Gtk.Box(spacing=8)
        self.get_btn = theme.css(Gtk.Button(label="Get a key"), "ai-deny")
        self.get_btn.connect("clicked", lambda *_: self._open_key_page())
        row.pack_start(self.get_btn, False, False, 0)
        save = theme.css(Gtk.Button(label="Turn on Stoa AI"), "ai-approve")
        save.connect("clicked", self._save_key)
        self.save_btn = save
        self.signin_creds = None
        row.pack_end(save, False, False, 0)
        box.pack_start(row, False, False, 0)
        self.setup_err = theme.css(Gtk.Label(xalign=0, wrap=True, max_width_chars=46), "ai-error")
        box.pack_start(self.setup_err, False, False, 0)
        GLib.idle_add(lambda: (self.provider_combo.set_active_id("claude"), False)[1])
        return box

    def _provider_changed(self, *_):
        from agent import PROVIDERS
        pid = self.provider_combo.get_active_id() or "claude"
        p = PROVIDERS[pid]
        self.url_entry.set_visible(pid == "custom")
        self.key_entry.set_visible(p["needs_key"])
        self.key_entry.set_placeholder_text(p["key_hint"] or "API key")
        is_oai = p["kind"] == "openai"
        self.model_row.set_visible(is_oai)
        self.get_btn.set_label("Get Ollama" if pid == "ollama" else "Get a key")
        self.get_btn.set_visible(bool(p["key_url"]))
        self.privacy.set_text(p["privacy"])
        self.model_combo.remove_all()
        self.model_combo.get_child().set_text(p["model"] if is_oai else "")
        self.setup_err.set_text("")
        self.save_btn.set_sensitive(True)
        self.signin_creds = None
        if p.get("signin"):
            import signin
            from agent import load_config
            cfg = load_config()
            if cfg and cfg.get("provider") == pid and cfg.get("api_key"):
                self.signin_creds = {k: cfg.get(k) for k in ("api_key", "refresh_token", "expires_at")}
                self.model_combo.get_child().set_text(cfg.get("model", ""))
            site = "OpenRouter" if pid == "openrouter" else "Hugging Face"
            self.get_btn.set_visible(bool(self.signin_creds))
            self.get_btn.set_label("Sign in again")
            self.model_row.set_visible(bool(self.signin_creds))
            self.save_btn.set_label("Save" if self.signin_creds else f"Sign in with {site}")
            ok, why = signin.available(p["signin"])
            if not ok:
                self.save_btn.set_sensitive(False)
                self.setup_err.set_text(why + " See the Stoa README to enable it.")
            elif self.signin_creds:
                self.setup_err.set_text(f"Signed in to {site}.")
        else:
            self.save_btn.set_label("Turn on Stoa AI")

    def _open_key_page(self):
        from agent import PROVIDERS
        p = PROVIDERS[self.provider_combo.get_active_id() or "claude"]
        if p.get("signin"):
            return self._sign_in()
        url = p["key_url"]
        if url:
            Gio.AppInfo.launch_default_for_uri(url, None)

    def _load_models(self, *_):
        from agent import list_models
        pid = self.provider_combo.get_active_id()
        key, url = self.key_entry.get_text().strip(), self.url_entry.get_text().strip()
        if self.signin_creds:
            key = self.signin_creds["api_key"]
        self.load_btn.set_sensitive(False)
        self.setup_err.set_text("Loading models…")

        def work():
            try:
                res = (list_models(pid, key, url), None)
            except Exception as e:  # noqa: BLE001 - shown to the person
                res = (None, str(e))
            GLib.idle_add(lambda: (done(*res), False)[1])

        def done(models, err):
            self.load_btn.set_sensitive(True)
            if err:
                self.setup_err.set_text(f"Couldn't load models: {err[:160]}")
                return
            self.model_combo.remove_all()
            for m in models:
                self.model_combo.append_text(m)
            self.setup_err.set_text(f"{len(models)} models available - pick one." if models else
                                    "No chat models found for this key.")
            if models:
                self.model_combo.set_active(0)
        threading.Thread(target=work, daemon=True).start()

    def _chat_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.scroll = Gtk.ScrolledWindow()
        self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.list.set_border_width(16)
        self.scroll.add(self.list)
        page.pack_start(self.scroll, True, True, 0)
        bottom = Gtk.Box(spacing=8)
        bottom.set_border_width(14)
        self.entry = theme.css(Gtk.Entry(placeholder_text="Ask Stoa AI…"), "ai-input")
        self.entry.connect("activate", self._send)
        bottom.pack_start(self.entry, True, True, 0)
        self.send_btn = theme.css(Gtk.Button(label="↑"), "ai-send")
        self.send_btn.connect("clicked", self._send)
        bottom.pack_start(self.send_btn, False, False, 0)
        page.pack_end(bottom, False, False, 0)
        return page

    def _welcome(self):
        for c in self.list.get_children():
            c.destroy()
        hello = theme.css(Gtk.Label(label="What do you need?", xalign=0), "fs-h1")
        self.list.pack_start(hello, False, False, 4)
        self.list.pack_start(theme.css(Gtk.Label(
            label="I can build apps for you on the spot, install software, change settings or answer questions.",
            xalign=0, wrap=True, max_width_chars=48), "fs-muted"), False, False, 0)
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=2, row_spacing=6,
                           column_spacing=6, homogeneous=False)
        for s in SUGGESTIONS:
            b = theme.css(Gtk.Button(label=s), "ai-chip")
            b.connect("clicked", lambda _b, s=s: self._send(text=s))
            flow.add(b)
        self.list.pack_start(flow, False, False, 8)
        self.list.show_all()

    # ---------------------------------------------------------------- behaviour
    def _enter(self):
        if self.agent.ready():
            self.stack.set_visible_child_name("chat")
            if not self.list.get_children():
                self._welcome()
            self.entry.grab_focus()
        else:
            self.stack.set_visible_child_name("setup")
            self.key_entry.grab_focus()
        self._update_subtitle()

    def _update_subtitle(self):
        d = self.agent.describe()
        self.subtitle.set_text(f"Using {d}" if d else "Ask for anything, or ask it to build an app")

    def _save_key(self, *_):
        from agent import PROVIDERS, save_config
        pid = self.provider_combo.get_active_id() or "claude"
        p = PROVIDERS[pid]
        key = self.key_entry.get_text().strip()
        model = self.model_combo.get_child().get_text().strip()
        url = self.url_entry.get_text().strip()
        if p.get("signin"):
            if not self.signin_creds:
                return self._sign_in()
            if not model:
                self.setup_err.set_text("Choose a model - press 'Load models' to see what's available.")
                return
            c = self.signin_creds
            save_config(pid, c["api_key"], model, "", c.get("refresh_token") or "", c.get("expires_at") or 0)
            self.agent.reset()
            for ch in self.list.get_children():
                ch.destroy()
            return self._enter()
        if p["needs_key"] and not key:
            self.setup_err.set_text("Paste your API key first.")
            return
        if pid == "claude" and not key.startswith("sk-ant-"):
            self.setup_err.set_text("That doesn't look like an Anthropic API key (it starts with sk-ant-).")
            return
        if pid == "custom" and not url.startswith(("http://", "https://")):
            self.setup_err.set_text("Enter the service's address (it starts with https://).")
            return
        if p["kind"] == "openai" and not model:
            self.setup_err.set_text("Choose a model - press 'Load models' to see what's available.")
            return
        save_config(pid, key, model, url)
        self.key_entry.set_text("")
        self.agent.reset()
        for c in self.list.get_children():
            c.destroy()
        self._enter()

    def _sign_in(self):
        """Browser sign-in (OAuth): the person signs in on the service's own site; no key to copy."""
        import signin
        from agent import PROVIDERS, pick_model, _models_json
        pid = self.provider_combo.get_active_id()
        p = PROVIDERS[pid]
        site = "OpenRouter" if pid == "openrouter" else "Hugging Face"
        self.save_btn.set_sensitive(False)
        self.get_btn.set_sensitive(False)
        self.setup_err.set_text(f"Sign in to {site} in your browser - you can use Google, GitHub or email "
                                "there. Then come back here.")

        def done(creds, err):
            model, merr = "", None
            if creds:
                try:
                    model = pick_model(pid, _models_json(pid, creds["api_key"]))
                except Exception as e:  # noqa: BLE001
                    merr = str(e)
            GLib.idle_add(lambda: (finish(creds, err, model, merr), False)[1])

        def finish(creds, err, model, merr):
            self.save_btn.set_sensitive(True)
            self.get_btn.set_sensitive(True)
            if err:
                self.setup_err.set_text(err)
                return
            self.signin_creds = creds
            self.model_row.set_visible(True)
            self.get_btn.set_visible(True)
            self.get_btn.set_label("Sign in again")
            self.save_btn.set_label("Save")
            self.model_combo.get_child().set_text(model)
            if merr or not model:
                self.setup_err.set_text(f"Signed in to {site}. Press 'Load models' and choose one.")
                return
            self.setup_err.set_text(f"Signed in to {site}. Using {model}.")
            self._save_key()

        signin.sign_in_async(p["signin"], done)

    def _menu(self, btn):
        m = Gtk.Menu()
        for label, fn in [("New conversation", self._new_chat), ("Change AI provider", self._change_key),
                          ("My AI apps", lambda: self._send(text="List the apps you've built for me."))]:
            it = Gtk.MenuItem(label=label)
            it.connect("activate", lambda _i, fn=fn: fn())
            m.append(it)
        m.show_all()
        m.popup_at_widget(btn, Gdk.Gravity.SOUTH_EAST, Gdk.Gravity.NORTH_EAST, None)

    def _new_chat(self):
        if not self.agent.busy:
            self.agent.reset()
            self._welcome()

    def _change_key(self):
        self.stack.set_visible_child_name("setup")
        self.key_entry.grab_focus()

    def _key(self, w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.hide()
            return True
        return False

    def _send(self, *_, text=None, display=None):
        text = (text or self.entry.get_text()).strip()
        if not text or self.agent.busy:
            return
        if not self.agent.client and not self.agent.ready():
            self._change_key()
            return
        self.entry.set_text("")
        if len(self.agent.messages) == 0:
            for c in self.list.get_children():
                c.destroy()
        self._bubble(display or text, "ai-user", Gtk.Align.END)
        self.current = None
        self._set_busy(True)
        self.agent.send(text)

    def _set_busy(self, busy):
        self.entry.set_sensitive(not busy)
        self.send_btn.set_sensitive(not busy)
        self.entry.set_placeholder_text("Working…" if busy else "Ask Stoa AI…")
        if not busy:
            self.entry.grab_focus()

    def _bubble(self, text, cls, align):
        lbl = theme.css(Gtk.Label(xalign=0, wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR, selectable=True,
                                  max_width_chars=44), cls)
        lbl.set_markup(markup(text))
        lbl.set_halign(align)
        self.list.pack_start(lbl, False, False, 0)
        lbl.show()
        self._scroll_end()
        return lbl

    def _scroll_end(self):
        GLib.idle_add(lambda: (self.scroll.get_vadjustment().set_value(
            self.scroll.get_vadjustment().get_upper()), False)[1])

    # ---------------------------------------------------------------- agent callbacks
    @ui_call
    def on_text_start(self):
        self.current_text = ""
        self.current = self._bubble("…", "ai-bot", Gtk.Align.START)

    @ui_call
    def on_text(self, delta):
        if not getattr(self, "current", None):
            self.current_text = ""
            self.current = self._bubble("", "ai-bot", Gtk.Align.START)
        self.current_text += delta
        self.current.set_markup(markup(self.current_text))
        self._scroll_end()

    @ui_call
    def on_tool_start(self, name):
        self.current = None
        doing, _ = TOOL_LABELS.get(name, ("Working", "Done"))
        card = theme.css(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4), "ai-tool")
        card.title = Gtk.Label(label=f"✦  {doing}…", xalign=0)
        card.pack_start(card.title, False, False, 0)
        card.code = theme.css(Gtk.Label(xalign=0, wrap=True, wrap_mode=Pango.WrapMode.CHAR, lines=4,
                                        ellipsize=Pango.EllipsizeMode.START, max_width_chars=60), "ai-code")
        card.pack_start(card.code, False, False, 0)
        card.code.set_no_show_all(True)
        self.list.pack_start(card, False, False, 0)
        card.show_all()
        self.tool_card = card
        self.tool_buf = ""
        self._scroll_end()

    @ui_call
    def on_tool_progress(self, name, chars, fragment):
        card = getattr(self, "tool_card", None)
        if not card:
            return
        if name == "build_app":
            self.tool_buf = (self.tool_buf + fragment)[-400:]
            m = re.search(r'"name"\s*:\s*"([^"]+)"', self.tool_buf)
            if m:
                card.app_name = m.group(1)
            nm = getattr(card, "app_name", "your app")
            card.title.set_text(f"✦  Building {nm}…  {chars / 1024:.1f} KB written")
            card.code.set_text(self.tool_buf.replace("\\n", "\n").replace('\\"', '"')[-260:])
            card.code.show()
            self._scroll_end()

    @ui_call
    def on_tool_done(self, name, args, out, is_error):
        card = getattr(self, "tool_card", None)
        if not card:
            return
        _, done = TOOL_LABELS.get(name, ("Working", "Done"))
        if is_error:
            card.get_style_context().add_class("ai-tool-err")
            card.title.set_text(f"✕  {out.splitlines()[0][:120]}")
        else:
            card.get_style_context().add_class("ai-tool-done")
            label = done
            if name == "build_app":
                label = f"Built {args.get('name', 'your app')} - it's open and in the Stoa menu"
            elif name in ("install_software", "open_app"):
                label = f"{done} {args.get('target') or args.get('name')}"
            card.title.set_text(f"✓  {label}")
        card.code.hide()
        self.tool_card = None

    @ui_call
    def on_error(self, msg):
        self.list.pack_start(theme.css(Gtk.Label(label=msg, xalign=0, wrap=True, max_width_chars=48), "ai-error"),
                             False, False, 0)
        self.list.show_all()
        self._scroll_end()

    @ui_call
    def on_done(self):
        self.current = None
        self._set_busy(False)

    def ask_approval(self, question, verb):
        """Called from the agent thread: show an Allow/Deny card and block until answered."""
        ev, answer = threading.Event(), {"ok": False}

        def show():
            card = theme.css(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8), "ai-tool")
            card.pack_start(Gtk.Label(label=question, xalign=0, wrap=True, max_width_chars=44), False, False, 0)
            row = Gtk.Box(spacing=8)
            yes = theme.css(Gtk.Button(label=verb), "ai-approve")
            no = theme.css(Gtk.Button(label="Not now"), "ai-deny")

            def done(ok):
                answer["ok"] = ok
                yes.set_sensitive(False)
                no.set_sensitive(False)
                ev.set()
            yes.connect("clicked", lambda *_: done(True))
            no.connect("clicked", lambda *_: done(False))
            row.pack_start(yes, False, False, 0)
            row.pack_start(no, False, False, 0)
            card.pack_start(row, False, False, 0)
            self.list.pack_start(card, False, False, 0)
            card.show_all()
            self.present()
            self._scroll_end()
            return False
        GLib.idle_add(show)
        ev.wait()
        return answer["ok"]


class Assistant(Gtk.Application):
    """stoa-assistant                  show or hide Stoa AI
    stoa-assistant --ask "text"      open Stoa AI and ask it something (from Search, other apps...)
    stoa-assistant --file PATH       open Stoa AI about a file (the Files right-click action)
    stoa-assistant --help-with TEXT  open Stoa AI to fix a problem, e.g. a failed install's log"""

    def __init__(self):
        super().__init__(application_id="os.stoa.Assistant", flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.panel = None

    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        text = display = None
        if len(args) >= 2 and args[0] == "--ask":
            text = " ".join(args[1:])
        elif len(args) >= 2 and args[0] == "--file":
            paths = [os.path.abspath(cmdline.get_cwd() and os.path.join(cmdline.get_cwd(), p) or p) for p in args[1:]]
            listing = "\n".join(paths)
            display = "📄 " + ", ".join(os.path.basename(p) for p in paths)
            text = (f"I've shared {'these files' if len(paths) > 1 else 'this file'} with you:\n{listing}\n"
                    "Read it, tell me in two or three sentences what it is, then suggest a few useful things you "
                    "could do with it (summarise, check, rewrite, convert, reply...).")
        elif len(args) >= 2 and args[0] == "--help-with":
            display = "Something went wrong - can you fix it?"
            text = ("Something went wrong on my computer. Here are the details:\n\n" + " ".join(args[1:])[-6000:] +
                    "\n\nWork out what caused it, explain it simply, and fix it if you can.")
        if text is None:
            self.activate()
            return 0
        if self.panel is None:
            self.activate()
        self.panel.show()
        self.panel._enter()
        self.panel.present()
        if self.panel.agent.busy:
            self.panel.entry.set_text(text)
        else:
            GLib.idle_add(lambda: (self.panel._send(text=text, display=display), False)[1])
        return 0

    def do_activate(self):
        if self.panel is None:
            theme.apply()
            prov = Gtk.CssProvider()
            prov.load_from_data(EXTRA_CSS)
            Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                                     Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 20)
            self.panel = Panel(self)
            self.hold()
        elif self.panel.get_visible():
            self.panel.hide()
        else:
            self.panel.show()
            self.panel._enter()
            self.panel.present()


if __name__ == "__main__":
    Assistant().run(sys.argv)
