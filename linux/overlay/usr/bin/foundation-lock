#!/bin/sh
# Foundation lock screen.
exec swaylock -f -i "$(foundation-wallpaper)" -s fill \
  --font Inter --font-size 22 --indicator-radius 90 --indicator-thickness 6 \
  --inside-color 13192acc --inside-clear-color 13192acc --inside-ver-color 13192acc --inside-wrong-color 13192acc \
  --ring-color 4f8cffcc --ring-ver-color 4f8cff --ring-clear-color 3fb37f --ring-wrong-color e0567a \
  --key-hl-color ffffff --bs-hl-color e0567a --line-uses-inside --separator-color 00000000 \
  --text-color ffffff --text-ver-color ffffff --text-wrong-color ffffff --text-clear-color ffffff \
  --text-caps-lock-color ffffff --show-failed-attempts --ignore-empty-password "$@"
