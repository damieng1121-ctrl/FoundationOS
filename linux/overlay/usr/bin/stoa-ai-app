#!/usr/bin/env python3
"""Run an app built by Stoa AI: stoa-ai-app <app-id>.

Apps are single HTML files shown in a WebKit view. Each app has its own storage, and cannot read your
files."""
import json
import os
import sys

app_id = sys.argv[1] if len(sys.argv) > 1 else ""
base = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "stoa", "ai-apps")
d = os.path.realpath(os.path.join(base, app_id))
if not app_id or not d.startswith(os.path.realpath(base) + os.sep) or not os.path.exists(os.path.join(d, "index.html")):
    sys.exit(f"stoa-ai-app: no app '{app_id}'")

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import GLib, Gtk, WebKit2  # noqa: E402

GLib.set_prgname(f"stoa-ai-{app_id}")
meta = {}
try:
    meta = json.load(open(os.path.join(d, "app.json")))
except (OSError, ValueError):
    pass

data = os.path.join(d, ".data")
ctx = WebKit2.WebContext.new_with_website_data_manager(
    WebKit2.WebsiteDataManager(base_data_directory=data, base_cache_directory=os.path.join(data, "cache")))
view = WebKit2.WebView.new_with_context(ctx)
s = view.get_settings()
s.set_enable_javascript(True)
s.set_allow_file_access_from_file_urls(False)
s.set_allow_universal_access_from_file_urls(False)
s.set_enable_developer_extras(False)
view.load_uri("file://" + os.path.join(d, "index.html"))

win = Gtk.Window(title=meta.get("name", app_id))
win.set_icon_name(meta.get("icon", "applications-utilities"))
win.set_default_size(960, 680)
win.add(view)
win.connect("destroy", Gtk.main_quit)
win.show_all()
Gtk.main()
