#!/usr/bin/env python3
"""Stoa AI: the assistant side panel. Run again to show/hide it."""
import html
import os
import re
import sys
import threading

SHELL_DIR = os.environ.get("STOA_SHELL_DIR", "/usr/lib/stoa/shell")
sys.path.insert(0, SHELL_DIR)
sys.path.insert(0, os.path.join(os.path.dirname(SHELL_DIR), "assistant"))

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, GtkLayerShell, Pango  # noqa: E402

import theme  # noqa: E402

EXTRA_CSS = b"""
.ai-panel { background-color: rgba(19, 25, 42, 0.985); border-radius: 18px; border: 1px solid rgba(255,255,255,0.08); }
.ai-head { padding: 16px 18px 10px 18px; }
.ai-title { font-size: 16px; font-weight: 800; color: white; }
.ai-sub { font-size: 12px; color: #8f9bb7; }
.ai-user { background-color: #4f8cff; color: white; border-radius: 16px 16px 4px 16px; padding: 9px 13px; }
.ai-bot { background-color: rgba(255,255,255,0.06); color: #e9edf7; border-radius: 16px 16px 16px 4px; padding: 9px 13px; }
.ai-tool { background-color: rgba(122,79,224,0.16); border: 1px solid rgba(122,79,224,0.45); color: #dcd2ff;
  border-radius: 12px; padding: 8px 12px; font-size: 12px; }
.ai-tool-done { background-color: rgba(63,179,127,0.14); border-color: rgba(63,179,127,0.5); color: #c9f0dc; }
.ai-tool-err { background-color: rgba(224,86,122,0.14); border-color: rgba(224,86,122,0.5); color: #ffd3de; }
.ai-code { font-family: monospace; font-size: 10px; color: #9fb3d9; }
.ai-error { color: #ffb4c6; font-size: 12px; padding: 4px 6px; }
.ai-chip { background-image: none; background-color: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08);
  border-radius: 14px; padding: 6px 12px; color: #dfe6f5; font-size: 12px; box-shadow: none; }
.ai-chip:hover { background-color: rgba(79,140,255,0.22); }
.ai-input { background-color: rgba(255,255,255,0.07); color: white; border: 1px solid rgba(255,255,255,0.10);
  border-radius: 22px; padding: 10px 16px; caret-color: #4f8cff; box-shadow: none; }
.ai-input:focus { border-color: #7a4fe0; }
.ai-send { background-image: none; background-color: #7a4fe0; color: white; border: none; border-radius: 50%;
  min-width: 40px; min-height: 40px; padding: 0; box-shadow: none; font-weight: 800; }
.ai-send:hover { background-color: #6a3fd0; }
.ai-approve { background-image: none; background-color: #3fb37f; color: white; border: none; border-radius: 10px;
  padding: 6px 16px; font-weight: 700; box-shadow: none; }
.ai-deny { background-image: none; background-color: rgba(255,255,255,0.08); color: white; border: none;
  border-radius: 10px; padding: 6px 16px; box-shadow: none; }
"""

SUGGESTIONS = [
    "Build me a Pomodoro timer",
    "Make a monthly budget tracker",
    "Install Google Chrome",
    "How much disk space do I have?",
    "Build a to-do list with priorities",
    "Turn the volume down to 30%",
]

TOOL_LABELS = {
    "build_app": ("Building your app", "Built"),
    "list_apps": ("Checking your apps", "Checked your apps"),
    "read_app": ("Reading the app", "Read the app"),
    "delete_app": ("Deleting the app", "Done"),
    "search_software": ("Searching the Stoa Store", "Searched the Store"),
    "install_software": ("Installing", "Installed"),
    "open_app": ("Opening", "Opened"),
    "change_setting": ("Changing a setting", "Setting changed"),
    "get_system_info": ("Checking your system", "Checked your system"),
}


def markup(text):
    """Very small Markdown -> Pango converter: **bold**, `code`, headings and bullets."""
    t = html.escape(text, quote=False)
    t = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", t)
    t = re.sub(r"`([^`]+)`", r"<tt>\1</tt>", t)
    t = re.sub(r"(?m)^#{1,6}\s*(.+)$", r"<b>\1</b>", t)
    t = re.sub(r"(?m)^\s*[-*]\s+", "• ", t)
    return t


def ui_call(fn):
    """Decorator: run a UI callback on the GTK main loop (callbacks arrive from the agent thread)."""
    def wrap(*a, **k):
        GLib.idle_add(lambda: (fn(*a, **k), False)[1])
    return wrap


class Panel(Gtk.Window):
    def __init__(self, app):
        super().__init__(application=app)
        self.set_title("Stoa AI")
        theme.transparent(self)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "stoa-ai")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.TOP)
        for e, m in ((GtkLayerShell.Edge.TOP, 8), (GtkLayerShell.Edge.BOTTOM, 68), (GtkLayerShell.Edge.RIGHT, 8)):
            GtkLayerShell.set_anchor(self, e, True)
            GtkLayerShell.set_margin(self, e, m)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
        self.set_size_request(440, -1)
        self.connect("key-press-event", self._key)

        from agent import Agent
        self.agent = Agent(self)

        root = theme.css(Gtk.Box(orientation=Gtk.Orientation.VERTICAL), "ai-panel")
        self.add(root)
        root.pack_start(self._header(), False, False, 0)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        root.pack_start(self.stack, True, True, 0)
        self.stack.add_named(self._setup_page(), "setup")
        self.stack.add_named(self._chat_page(), "chat")
        self.show_all()
        self._enter()

    # ---------------------------------------------------------------- layout
    def _header(self):
        h = theme.css(Gtk.Box(spacing=12), "ai-head")
        pb = GdkPixbuf.Pixbuf.new_from_file_at_size("/usr/share/stoa/logo-round-96.png", 36, 36)
        h.pack_start(Gtk.Image.new_from_pixbuf(pb), False, False, 0)
        t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        t.pack_start(theme.css(Gtk.Label(label="Stoa AI", xalign=0), "ai-title"), False, False, 0)
        t.pack_start(theme.css(Gtk.Label(label="Ask for anything, or ask it to build an app", xalign=0), "ai-sub"),
                     False, False, 0)
        h.pack_start(t, True, True, 0)
        menu = theme.css(Gtk.Button(label="⋯"), "fs-power-btn")
        menu.connect("clicked", self._menu)
        h.pack_end(menu, False, False, 0)
        close = theme.css(Gtk.Button(label="✕"), "fs-power-btn")
        close.connect("clicked", lambda *_: self.hide())
        h.pack_end(close, False, False, 0)
        return h

    def _setup_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_border_width(22)
        box.pack_start(theme.css(Gtk.Label(label="Connect Stoa AI", xalign=0), "fs-h1"), False, False, 0)
        box.pack_start(theme.css(Gtk.Label(
            label="Stoa AI is powered by Claude. Paste an Anthropic API key to turn it on - you can create "
                  "one at console.anthropic.com.\n\nYour key is stored only on this computer. What you type to "
                  "Stoa AI is sent to Anthropic to generate replies.",
            xalign=0, wrap=True, max_width_chars=46), "fs-muted"), False, False, 0)
        self.key_entry = theme.css(Gtk.Entry(placeholder_text="sk-ant-…", visibility=False), "ai-input")
        self.key_entry.connect("activate", self._save_key)
        box.pack_start(self.key_entry, False, False, 0)
        row = Gtk.Box(spacing=8)
        get = theme.css(Gtk.Button(label="Get a key"), "ai-deny")
        get.connect("clicked", lambda *_: Gio.AppInfo.launch_default_for_uri("https://console.anthropic.com/", None))
        row.pack_start(get, False, False, 0)
        save = theme.css(Gtk.Button(label="Turn on Stoa AI"), "ai-approve")
        save.connect("clicked", self._save_key)
        row.pack_end(save, False, False, 0)
        box.pack_start(row, False, False, 0)
        self.setup_err = theme.css(Gtk.Label(xalign=0, wrap=True), "ai-error")
        box.pack_start(self.setup_err, False, False, 0)
        return box

    def _chat_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.scroll = Gtk.ScrolledWindow()
        self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.list.set_border_width(16)
        self.scroll.add(self.list)
        page.pack_start(self.scroll, True, True, 0)
        bottom = Gtk.Box(spacing=8)
        bottom.set_border_width(14)
        self.entry = theme.css(Gtk.Entry(placeholder_text="Ask Stoa AI…"), "ai-input")
        self.entry.connect("activate", self._send)
        bottom.pack_start(self.entry, True, True, 0)
        self.send_btn = theme.css(Gtk.Button(label="↑"), "ai-send")
        self.send_btn.connect("clicked", self._send)
        bottom.pack_start(self.send_btn, False, False, 0)
        page.pack_end(bottom, False, False, 0)
        return page

    def _welcome(self):
        for c in self.list.get_children():
            c.destroy()
        hello = theme.css(Gtk.Label(label="What do you need?", xalign=0), "fs-h1")
        self.list.pack_start(hello, False, False, 4)
        self.list.pack_start(theme.css(Gtk.Label(
            label="I can build apps for you on the spot, install software, change settings or answer questions.",
            xalign=0, wrap=True, max_width_chars=48), "fs-muted"), False, False, 0)
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=2, row_spacing=6,
                           column_spacing=6, homogeneous=False)
        for s in SUGGESTIONS:
            b = theme.css(Gtk.Button(label=s), "ai-chip")
            b.connect("clicked", lambda _b, s=s: self._send(text=s))
            flow.add(b)
        self.list.pack_start(flow, False, False, 8)
        self.list.show_all()

    # ---------------------------------------------------------------- behaviour
    def _enter(self):
        if self.agent.ready():
            self.stack.set_visible_child_name("chat")
            if not self.list.get_children():
                self._welcome()
            self.entry.grab_focus()
        else:
            self.stack.set_visible_child_name("setup")
            self.key_entry.grab_focus()

    def _save_key(self, *_):
        key = self.key_entry.get_text().strip()
        if not key.startswith("sk-"):
            self.setup_err.set_text("That doesn't look like an Anthropic API key (it should start with sk-).")
            return
        from agent import save_key
        save_key(key)
        self.key_entry.set_text("")
        self._enter()

    def _menu(self, btn):
        m = Gtk.Menu()
        for label, fn in [("New conversation", self._new_chat), ("Change API key", self._change_key),
                          ("My AI apps", lambda: self._send(text="List the apps you've built for me."))]:
            it = Gtk.MenuItem(label=label)
            it.connect("activate", lambda _i, fn=fn: fn())
            m.append(it)
        m.show_all()
        m.popup_at_widget(btn, Gdk.Gravity.SOUTH_EAST, Gdk.Gravity.NORTH_EAST, None)

    def _new_chat(self):
        if not self.agent.busy:
            self.agent.reset()
            self._welcome()

    def _change_key(self):
        self.stack.set_visible_child_name("setup")
        self.key_entry.grab_focus()

    def _key(self, w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.hide()
            return True
        return False

    def _send(self, *_, text=None):
        text = (text or self.entry.get_text()).strip()
        if not text or self.agent.busy:
            return
        if not self.agent.client and not self.agent.ready():
            self._change_key()
            return
        self.entry.set_text("")
        if len(self.agent.messages) == 0:
            for c in self.list.get_children():
                c.destroy()
        self._bubble(text, "ai-user", Gtk.Align.END)
        self.current = None
        self._set_busy(True)
        self.agent.send(text)

    def _set_busy(self, busy):
        self.entry.set_sensitive(not busy)
        self.send_btn.set_sensitive(not busy)
        self.entry.set_placeholder_text("Working…" if busy else "Ask Stoa AI…")
        if not busy:
            self.entry.grab_focus()

    def _bubble(self, text, cls, align):
        lbl = theme.css(Gtk.Label(xalign=0, wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR, selectable=True,
                                  max_width_chars=44), cls)
        lbl.set_markup(markup(text))
        lbl.set_halign(align)
        self.list.pack_start(lbl, False, False, 0)
        lbl.show()
        self._scroll_end()
        return lbl

    def _scroll_end(self):
        GLib.idle_add(lambda: (self.scroll.get_vadjustment().set_value(
            self.scroll.get_vadjustment().get_upper()), False)[1])

    # ---------------------------------------------------------------- agent callbacks
    @ui_call
    def on_text_start(self):
        self.current_text = ""
        self.current = self._bubble("…", "ai-bot", Gtk.Align.START)

    @ui_call
    def on_text(self, delta):
        if not getattr(self, "current", None):
            self.current_text = ""
            self.current = self._bubble("", "ai-bot", Gtk.Align.START)
        self.current_text += delta
        self.current.set_markup(markup(self.current_text))
        self._scroll_end()

    @ui_call
    def on_tool_start(self, name):
        self.current = None
        doing, _ = TOOL_LABELS.get(name, ("Working", "Done"))
        card = theme.css(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4), "ai-tool")
        card.title = Gtk.Label(label=f"✦  {doing}…", xalign=0)
        card.pack_start(card.title, False, False, 0)
        card.code = theme.css(Gtk.Label(xalign=0, wrap=True, wrap_mode=Pango.WrapMode.CHAR, lines=4,
                                        ellipsize=Pango.EllipsizeMode.START, max_width_chars=60), "ai-code")
        card.pack_start(card.code, False, False, 0)
        card.code.set_no_show_all(True)
        self.list.pack_start(card, False, False, 0)
        card.show_all()
        self.tool_card = card
        self.tool_buf = ""
        self._scroll_end()

    @ui_call
    def on_tool_progress(self, name, chars, fragment):
        card = getattr(self, "tool_card", None)
        if not card:
            return
        if name == "build_app":
            self.tool_buf = (self.tool_buf + fragment)[-400:]
            m = re.search(r'"name"\s*:\s*"([^"]+)"', self.tool_buf)
            if m:
                card.app_name = m.group(1)
            nm = getattr(card, "app_name", "your app")
            card.title.set_text(f"✦  Building {nm}…  {chars / 1024:.1f} KB written")
            card.code.set_text(self.tool_buf.replace("\\n", "\n").replace('\\"', '"')[-260:])
            card.code.show()
            self._scroll_end()

    @ui_call
    def on_tool_done(self, name, args, out, is_error):
        card = getattr(self, "tool_card", None)
        if not card:
            return
        _, done = TOOL_LABELS.get(name, ("Working", "Done"))
        if is_error:
            card.get_style_context().add_class("ai-tool-err")
            card.title.set_text(f"✕  {out.splitlines()[0][:120]}")
        else:
            card.get_style_context().add_class("ai-tool-done")
            label = done
            if name == "build_app":
                label = f"Built {args.get('name', 'your app')} - it's open and in Start"
            elif name in ("install_software", "open_app"):
                label = f"{done} {args.get('target') or args.get('name')}"
            card.title.set_text(f"✓  {label}")
        card.code.hide()
        self.tool_card = None

    @ui_call
    def on_error(self, msg):
        self.list.pack_start(theme.css(Gtk.Label(label=msg, xalign=0, wrap=True, max_width_chars=48), "ai-error"),
                             False, False, 0)
        self.list.show_all()
        self._scroll_end()

    @ui_call
    def on_done(self):
        self.current = None
        self._set_busy(False)

    def ask_approval(self, question, verb):
        """Called from the agent thread: show an Allow/Deny card and block until answered."""
        ev, answer = threading.Event(), {"ok": False}

        def show():
            card = theme.css(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8), "ai-tool")
            card.pack_start(Gtk.Label(label=question, xalign=0, wrap=True, max_width_chars=44), False, False, 0)
            row = Gtk.Box(spacing=8)
            yes = theme.css(Gtk.Button(label=verb), "ai-approve")
            no = theme.css(Gtk.Button(label="Not now"), "ai-deny")

            def done(ok):
                answer["ok"] = ok
                yes.set_sensitive(False)
                no.set_sensitive(False)
                ev.set()
            yes.connect("clicked", lambda *_: done(True))
            no.connect("clicked", lambda *_: done(False))
            row.pack_start(yes, False, False, 0)
            row.pack_start(no, False, False, 0)
            card.pack_start(row, False, False, 0)
            self.list.pack_start(card, False, False, 0)
            card.show_all()
            self.present()
            self._scroll_end()
            return False
        GLib.idle_add(show)
        ev.wait()
        return answer["ok"]


class Assistant(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="os.stoa.Assistant", flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.panel = None

    def do_activate(self):
        if self.panel is None:
            theme.apply()
            prov = Gtk.CssProvider()
            prov.load_from_data(EXTRA_CSS)
            Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                                     Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 20)
            self.panel = Panel(self)
            self.hold()
        elif self.panel.get_visible():
            self.panel.hide()
        else:
            self.panel.show()
            self.panel._enter()
            self.panel.present()


if __name__ == "__main__":
    Assistant().run(sys.argv[:1])
