#!/bin/sh
# foundation-screenshot full|area: save to ~/Pictures/Screenshots, copy to clipboard, notify.
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
f="$dir/Screenshot $(date '+%Y-%m-%d %H-%M-%S').png"
if [ "$1" = "area" ]; then
  geo="$(slurp)" || exit 0
  grim -g "$geo" "$f"
else
  grim "$f"
fi
command -v wl-copy >/dev/null && wl-copy < "$f"
notify-send -i "$f" "Screenshot saved" "Copied to the clipboard and saved in Pictures › Screenshots"
