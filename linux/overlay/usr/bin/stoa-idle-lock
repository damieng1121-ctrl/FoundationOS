#!/bin/sh
# Lock the screen after the edition's idle time (Stoa Business: 5 minutes). 0 or missing = never.
m="$(cat "$HOME/.config/stoa/lock-minutes" 2>/dev/null || cat /etc/stoa/lock-minutes 2>/dev/null || echo 0)"
case "$m" in ''|*[!0-9]*) exit 0 ;; esac
[ "$m" -gt 0 ] || exit 0
command -v swayidle >/dev/null 2>&1 || exit 0
exec swayidle -w timeout "$((m * 60))" 'stoa-lock' before-sleep 'stoa-lock'
