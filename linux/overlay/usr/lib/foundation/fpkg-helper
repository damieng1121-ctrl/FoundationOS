#!/usr/bin/env python3
"""Privileged half of fpkg. Runs as root (via sudo/pkexec) and only performs a fixed set of
operations. Repositories are only ever taken from the system catalog, never from arguments."""
import os
import re
import subprocess
import sys
import urllib.request

import yaml

CATALOG = "/usr/share/foundation/catalog.yaml"
PKG_RE = re.compile(r"^[a-z0-9][a-z0-9.+\-]*(:[a-z0-9]+)?$")
ENV = {**os.environ, "DEBIAN_FRONTEND": "noninteractive", "PATH": "/usr/sbin:/usr/bin:/sbin:/bin"}
APT = ["apt-get", "-y", "-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold"]


def sh(cmd):
    print("# " + " ".join(cmd), flush=True)
    r = subprocess.run(cmd, env=ENV)
    if r.returncode:
        sys.exit(r.returncode)


def pkgs(names):
    for n in names:
        if not PKG_RE.match(n):
            sys.exit(f"invalid package name: {n}")
    return names


def repo_add(app_id):
    with open(CATALOG) as f:
        apps = {a["id"]: a for a in yaml.safe_load(f)["apps"]}
    app = apps.get(app_id)
    if not app or app.get("source") != "apt-repo":
        sys.exit(f"{app_id} has no repository in the catalog")
    repo = app["repo"]
    os.makedirs("/etc/apt/keyrings", mode=0o755, exist_ok=True)
    req = urllib.request.Request(repo["key"], headers={"User-Agent": "fpkg-helper"})
    with urllib.request.urlopen(req, timeout=60) as r:
        key = r.read()
    keyring = f"/etc/apt/keyrings/{repo['keyring']}"
    if key.lstrip().startswith(b"-----BEGIN"):
        subprocess.run(["gpg", "--batch", "--yes", "--dearmor", "-o", keyring], input=key, check=True)
    else:
        with open(keyring, "wb") as f:
            f.write(key)
    os.chmod(keyring, 0o644)
    with open(f"/etc/apt/sources.list.d/{repo['list']}", "w") as f:
        f.write(repo["line"].replace("@KEYRING@", keyring) + "\n")
    if repo.get("pin"):
        with open(f"/etc/apt/preferences.d/fpkg-{app_id}", "w") as f:
            f.write(repo["pin"])
    sh(["apt-get", "update"])


def main():
    if os.geteuid() != 0:
        sys.exit("fpkg-helper must run as root")
    if len(sys.argv) < 2:
        sys.exit("usage: fpkg-helper <op> [args]")
    op, args = sys.argv[1], sys.argv[2:]
    if op == "repo-add":
        repo_add(args[0])
    elif op == "apt-install":
        sh(["apt-get", "update"])
        sh(APT + ["install", *pkgs(args)])
    elif op == "apt-remove":
        sh(APT + ["remove", *pkgs(args)])
        sh(APT + ["autoremove"])
    elif op == "deb-install":
        path = os.path.realpath(args[0])
        if not path.endswith(".deb") or not os.path.isfile(path):
            sys.exit("not a .deb file")
        sh(["apt-get", "update"])
        sh(APT + ["install", path])
    elif op == "upgrade":
        sh(["apt-get", "update"])
        sh(APT + ["full-upgrade"])
        sh(APT + ["autoremove"])
        if os.path.exists("/usr/bin/flatpak"):
            subprocess.run(["flatpak", "update", "--system", "-y", "--noninteractive"], env=ENV)
    elif op == "refresh":
        sh(["apt-get", "update"])
    else:
        sys.exit(f"unknown operation {op}")


if __name__ == "__main__":
    main()
