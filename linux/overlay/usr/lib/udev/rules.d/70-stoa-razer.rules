# Stoa: Razer keyboards, mice and headsets (USB vendor 1532).
#
# Never let USB power saving suspend them - the usual cause of a Razer keyboard or mouse "freezing"
# for a moment (or until it's unplugged) on Linux.
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="1532", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="1532", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1"

# Lighting and DPI apps (OpenRGB, OpenRazer tools) may talk to Razer devices as the signed-in person,
# without administrator rights. (uaccess is applied by systemd-logind's seat rules, which run after 70.)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1532", TAG+="uaccess"
