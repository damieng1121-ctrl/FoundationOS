#!/usr/bin/env python3
"""Privileged half of Stoa Protect. Runs as root (pkexec/sudo) and only does a fixed set of things:

  firewall on|off          turn the firewall (ufw: block incoming, allow outgoing) on or off
  update-signatures        download the latest antivirus signatures now
  tpm-enroll               let the TPM unlock the encrypted system drive (disk password on stdin)
  tpm-remove               stop the TPM unlocking the drive (the password keeps working)
"""
import json
import os
import re
import subprocess
import sys

ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8"}
# PCR 7 = Secure Boot policy and firmware state: the key is only released on this PC with its boot
# settings unchanged. Kernel updates don't change it, so updates never lock you out.
TPM_MARK = "/etc/stoa/tpm-unlock"
TPM_POLICY = json.dumps({"pcr_bank": "sha256", "pcr_ids": "7"})


def sh(cmd, **kw):
    r = subprocess.run(cmd, env=ENV, **kw)
    if r.returncode:
        sys.exit(r.returncode)
    return r


def root_luks_device():
    """The LUKS partition under / (e.g. /dev/sda3), or None if the system isn't encrypted."""
    src = subprocess.run(["findmnt", "-no", "SOURCE", "/"], capture_output=True, text=True, env=ENV).stdout.strip()
    if not src.startswith("/dev/mapper/"):
        return None
    st = subprocess.run(["cryptsetup", "status", src], capture_output=True, text=True, env=ENV).stdout
    m = re.search(r"^\s*device:\s*(\S+)", st, re.M)
    return m.group(1) if m else None


def tpm_slots(dev):
    out = subprocess.run(["clevis", "luks", "list", "-d", dev], capture_output=True, text=True, env=ENV).stdout
    return [l.split(":")[0].strip() for l in out.splitlines() if "tpm2" in l]


def main():
    if os.geteuid() != 0:
        sys.exit("security-helper must run as root")
    op, args = (sys.argv[1], sys.argv[2:]) if len(sys.argv) > 1 else ("", [])
    if op == "firewall" and args in (["on"], ["off"]):
        sh(["ufw", "--force", "enable" if args[0] == "on" else "disable"])
        sh(["systemctl", "enable" if args[0] == "on" else "disable", "ufw.service"], capture_output=True)
    elif op == "update-signatures":
        # freshclam refuses to run while its service holds the lock; restarting the service updates now.
        if subprocess.run(["systemctl", "is-enabled", "--quiet", "clamav-freshclam.service"], env=ENV).returncode == 0:
            sh(["systemctl", "restart", "clamav-freshclam.service"])
        else:
            sh(["freshclam", "--quiet"])
    elif op == "tpm-enroll":
        dev = root_luks_device()
        if not dev:
            sys.exit("This system drive isn't encrypted. Encryption is chosen when Stoa is installed.")
        if not os.path.exists("/dev/tpmrm0"):
            sys.exit("No TPM chip was found. Turn on TPM (or fTPM/PTT) in the firmware (BIOS) settings.")
        password = sys.stdin.read().rstrip("\n")
        if tpm_slots(dev):
            os.makedirs("/etc/stoa", exist_ok=True)
            with open(TPM_MARK, "w") as f:
                f.write(dev + "\n")
            print("The TPM already unlocks this drive.")
            return
        r = subprocess.run(["clevis", "luks", "bind", "-y", "-k", "-", "-d", dev, "tpm2", TPM_POLICY],
                           input=password, text=True, env=ENV, capture_output=True)
        if r.returncode:
            sys.exit("That password didn't unlock the drive." if "passphrase" in (r.stderr + r.stdout).lower()
                     else f"Couldn't set up the TPM: {r.stderr.strip() or r.stdout.strip()}")
        sh(["update-initramfs", "-u", "-k", "all"], capture_output=True)
        os.makedirs("/etc/stoa", exist_ok=True)
        with open(TPM_MARK, "w") as f:
            f.write(dev + "\n")
        print("Done. The drive now unlocks automatically on this PC; your password still works as a backup.")
    elif op == "tpm-remove":
        dev = root_luks_device()
        if not dev:
            sys.exit("This system drive isn't encrypted.")
        for slot in tpm_slots(dev):
            sh(["clevis", "luks", "unbind", "-f", "-d", dev, "-s", slot])
        sh(["update-initramfs", "-u", "-k", "all"], capture_output=True)
        if os.path.exists(TPM_MARK):
            os.remove(TPM_MARK)
        print("Done. The drive asks for your password at start-up again.")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
