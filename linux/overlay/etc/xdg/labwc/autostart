# Stoa desktop session components (run by labwc at login).
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE DISPLAY >/dev/null 2>&1
# Stoa Shell: desktop, bar, Stoa menu, Quick Settings, calendar, Go To.
stoa-shell >/dev/null 2>&1 &
# Keep the desktop sized to the screen (VM window resizes, monitors, compatibility mode).
stoa-display-follow >/dev/null 2>&1 &
mako >/dev/null 2>&1 &
lxpolkit >/dev/null 2>&1 &
command -v spice-vdagent >/dev/null && spice-vdagent >/dev/null 2>&1 &
# Stoa Protect: scan new downloads for viruses as they arrive.
stoa-protect watch >/dev/null 2>&1 &
stoa-welcome --autostart >/dev/null 2>&1 &
# Apps people chose to open at sign-in (Task Manager > Start-up apps; Steam, Discord...).
stoa-taskmgr --autostart >/dev/null 2>&1 &
