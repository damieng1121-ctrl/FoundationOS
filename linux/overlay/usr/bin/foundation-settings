#!/usr/bin/env python3
"""Foundation Settings hub."""
import os
import subprocess
import sys

sys.path.insert(0, "/usr/lib/foundation")
import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk  # noqa: E402

import foundation_ui as ui  # noqa: E402


def pick_wallpaper(parent):
    dlg = Gtk.FileChooserDialog(title="Choose a wallpaper", parent=parent, action=Gtk.FileChooserAction.OPEN)
    dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Set wallpaper", Gtk.ResponseType.OK)
    f = Gtk.FileFilter()
    f.add_mime_type("image/*")
    dlg.add_filter(f)
    if dlg.run() == Gtk.ResponseType.OK:
        path = dlg.get_filename()
        cfg = os.path.expanduser("~/.config/foundation")
        os.makedirs(cfg, exist_ok=True)
        with open(os.path.join(cfg, "wallpaper"), "w") as fh:
            fh.write(path)
        subprocess.run(["pkill", "-x", "swaybg"])
        ui.spawn("swaybg", "-m", "fill", "-i", path)
    dlg.destroy()


TILES = [
    ("Network & Wi-Fi", "network-wireless", ["nm-connection-editor"]),
    ("Sound", "audio-volume-high", ["pavucontrol"]),
    ("Bluetooth", "bluetooth", ["blueman-manager"]),
    ("Wallpaper", "preferences-desktop-wallpaper", None),
    ("Software & Updates", "system-software-update", ["foundation-store"]),
    ("Install updates now", "software-update-available", ["foundation-updates"]),
    ("Files", "system-file-manager", ["thunar"]),
    ("Terminal", "utilities-terminal", ["foot"]),
    ("System monitor", "utilities-system-monitor", ["foot", "-e", "top"]),
]


def main():
    ui.apply_css()
    if len(sys.argv) > 1 and sys.argv[1] == "wallpaper":
        pick_wallpaper(None)
        return
    win = Gtk.Window(title="Foundation Settings")
    win.set_default_size(640, 460)
    win.set_icon_name("foundation")
    win.connect("destroy", Gtk.main_quit)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
    box.set_border_width(18)
    win.add(box)
    box.pack_start(ui.css(Gtk.Label(label="Settings", xalign=0), "f-title"), False, False, 0)
    grid = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=3, min_children_per_line=3,
                       homogeneous=True, row_spacing=10, column_spacing=10)
    for label, icon, cmd in TILES:
        b = ui.css(Gtk.Button(), "f-card")
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG)
        img.set_pixel_size(40)
        v.pack_start(img, False, False, 0)
        v.pack_start(Gtk.Label(label=label), False, False, 0)
        b.add(v)
        if cmd:
            b.connect("clicked", lambda _b, c=cmd: ui.spawn(*c))
        else:
            b.connect("clicked", lambda *_: pick_wallpaper(win))
        grid.add(b)
    box.pack_start(grid, True, True, 0)
    ver = open("/usr/share/foundation/VERSION").read().strip() if os.path.exists("/usr/share/foundation/VERSION") else "?"
    kernel = os.uname().release
    box.pack_start(ui.css(Gtk.Label(label=f"Foundation OS {ver}  ·  Linux {kernel}", xalign=0), "f-muted"),
                   False, False, 0)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
