#!/bin/sh
# Update Stoa to the newest version.
#   stoa-os-update                 # download the newest version online (checked and verified), or failing that
#                                  # the newest stoa-desktop_*.deb / stoa-update*.zip in ~/Downloads
#   stoa-os-update path/to/file    # a specific .deb or .zip
#   (The Updates app does the same with one click, and can do it automatically.)
set -e
src="$1"
if [ -z "$src" ] && sudo /usr/lib/stoa/fpkg-helper os-update; then
  echo "Sign out and back in to use the new version."
  exit 0
fi
if [ -z "$src" ]; then
  echo "Couldn't update online; looking in ~/Downloads instead."
  src="$(ls -t "$HOME"/Downloads/stoa-desktop_*.deb "$HOME"/Downloads/stoa-update*.zip 2>/dev/null | head -1)"
  [ -n "$src" ] || { echo "No Stoa update found in ~/Downloads (stoa-desktop_*.deb or stoa-update.zip)." >&2; exit 1; }
fi
[ -f "$src" ] || { echo "Not found: $src" >&2; exit 1; }
tmp="$(mktemp -d)"
trap 'rm -rf -- "$tmp"' EXIT
case "$src" in
  *.zip)
    python3 -c 'import sys,zipfile; zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])' "$src" "$tmp"
    deb="$(ls "$tmp"/stoa-desktop_*.deb 2>/dev/null | sort -V | tail -1)"
    [ -n "$deb" ] || { echo "That zip has no Stoa update package in it." >&2; exit 1; } ;;
  *.deb) cp "$src" "$tmp/"; deb="$tmp/$(basename "$src")" ;;
  *) echo "Expected a .deb or .zip: $src" >&2; exit 1 ;;
esac
chmod 0644 "$deb"; chmod 0755 "$tmp"
echo "Installing $(basename "$deb")"
sudo apt-get install -y "$deb"
