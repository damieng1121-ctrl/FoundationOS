# Stoa kernel configuration, merged on top of Ubuntu's generic configuration.
# Ubuntu's config gives broad hardware support; these lines make it Stoa's.

# Identity
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="stoa"

# Desktop responsiveness: fully preemptible kernel, 1000 Hz timer
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT_NONE is not set
CONFIG_HZ_1000=y
# CONFIG_HZ_250 is not set
CONFIG_HZ=1000

# Faster, smaller build and install: no debug info
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set

# Ubuntu's signing certificates are not ours; modules are signed with a key generated per build
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_MODULE_SIG_ALL=y

# Stoa boot logo (shown on the framebuffer console during verbose boots)
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y

# Compressed RAM swap uses zstd by default (Stoa turns zram swap on: old PCs with little RAM feel faster)
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# Windows games and apps: NT synchronization primitives in the kernel, used by Wine and Proton (/dev/ntsync)
CONFIG_NTSYNC=y

# Memory: multi-generational LRU, on by default - fewer stalls when memory is tight
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# Network: BBR congestion control (with the fq qdisc) - faster, steadier downloads and streaming
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_DEFAULT_BBR=y

# Rust drivers need a matching Rust toolchain at build time; Stoa's build uses C drivers only
# CONFIG_RUST is not set
