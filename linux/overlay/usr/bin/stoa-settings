#!/usr/bin/env python3
"""Stoa Settings hub."""
import glob
import os
import shutil
import subprocess
import sys

sys.path.insert(0, "/usr/lib/stoa")
import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk  # noqa: E402

import stoa_ui as ui  # noqa: E402


WALLPAPERS = ["/usr/share/stoa/wallpaper.jpg"] + sorted(glob.glob("/usr/share/stoa/wallpapers/*.jpg"))
CONFIG_DIR = os.path.expanduser("~/.config/stoa")
OWN_COPIES = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "stoa", "wallpaper")
IMAGE_EXT = (".jpg", ".jpeg", ".png", ".webp", ".heic", ".heif", ".avif", ".bmp", ".gif", ".tif", ".tiff")


def current_wallpaper():
    try:
        with open(os.path.join(CONFIG_DIR, "wallpaper")) as f:
            p = f.read().strip()
        return p if os.path.exists(p) else WALLPAPERS[0]
    except OSError:
        return WALLPAPERS[0]


def set_wallpaper(path):
    """Use a picture as the wallpaper. Returns an error message, or None.

    Built-in wallpapers are used where they are. Anything else is turned upright (phone photos), scaled to at
    most 4K and saved as Stoa's own JPEG copy, so WebP/HEIC/AVIF photos work and the wallpaper survives the
    original being moved, deleted or on a USB stick that's unplugged."""
    from gi.repository import GdkPixbuf, GLib
    import time
    if path not in WALLPAPERS:
        try:
            pb = GdkPixbuf.Pixbuf.new_from_file(path)
        except GLib.Error:
            return f"{os.path.basename(path)} can't be used as a wallpaper - Stoa can't read that kind of picture."
        pb = pb.apply_embedded_orientation() or pb
        w, h = pb.get_width(), pb.get_height()
        if w < 320 or h < 200:
            return "That picture is too small to use as a wallpaper."
        scale = min(1.0, 3840 / max(w, h))
        if scale < 1.0:
            pb = pb.scale_simple(int(w * scale), int(h * scale), GdkPixbuf.InterpType.HYPER)
        os.makedirs(OWN_COPIES, exist_ok=True)
        for old in glob.glob(os.path.join(OWN_COPIES, "wallpaper-*.jpg")):
            os.remove(old)
        path = os.path.join(OWN_COPIES, f"wallpaper-{int(time.time())}.jpg")
        if pb.get_has_alpha():  # JPEG has no transparency: flatten onto Stoa navy
            bg = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, False, 8, pb.get_width(), pb.get_height())
            bg.fill(0x121829FF)
            pb.composite(bg, 0, 0, pb.get_width(), pb.get_height(), 0, 0, 1, 1, GdkPixbuf.InterpType.BILINEAR, 255)
            pb = bg
        pb.savev(path, "jpeg", ["quality"], ["92"])
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(os.path.join(CONFIG_DIR, "wallpaper"), "w") as fh:
        fh.write(path)
    subprocess.run(["stoa-shell", "wallpaper"], capture_output=True, timeout=15)
    return None


def recent_pictures(limit=12):
    from gi.repository import GLib
    pics = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES) or os.path.expanduser("~/Pictures")
    found = []
    for root, dirs, files in os.walk(pics):
        dirs[:] = [d for d in dirs if not d.startswith(".")]
        if root.count(os.sep) - pics.count(os.sep) > 2:
            dirs[:] = []
        found += [os.path.join(root, f) for f in files if f.lower().endswith(IMAGE_EXT)]
        if len(found) > 400:
            break
    found.sort(key=lambda p: os.path.getmtime(p), reverse=True)
    return found[:limit]


def pick_wallpaper(parent):
    from gi.repository import GdkPixbuf, GLib
    dlg = Gtk.Dialog(title="Wallpaper", transient_for=parent, modal=bool(parent))
    dlg.set_default_size(*ui.fit_size(760, 560))
    area = dlg.get_content_area()
    area.set_border_width(16)
    area.set_spacing(10)
    area.pack_start(ui.css(Gtk.Label(label="Wallpaper", xalign=0), "f-title"), False, False, 0)
    sw = Gtk.ScrolledWindow(vexpand=True)
    sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    sw.add(inner)
    area.pack_start(sw, True, True, 0)
    status = ui.css(Gtk.Label(xalign=0, wrap=True), "f-muted")
    buttons = []

    def apply(path):
        err = set_wallpaper(path)
        status.set_text(err or "Wallpaper changed.")
        mark(current_wallpaper() if not err else None)

    def mark(cur):
        for b, p in buttons:  # highlight the built-in wallpaper in use (your own pictures are used as copies)
            ctx = b.get_style_context()
            (ctx.add_class if p == cur else ctx.remove_class)("f-selected")

    def section(title, paths):
        if not paths:
            return
        inner.pack_start(ui.css(Gtk.Label(label=title, xalign=0), "f-h2"), False, False, 0)
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=4, min_children_per_line=2,
                           row_spacing=8, column_spacing=8, homogeneous=True)
        for p in paths:
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(p, 168, 95, False)
            except GLib.Error:
                continue  # an unreadable picture: leave it out of the gallery
            b = ui.css(Gtk.Button(), "f-thumb")
            b.add(Gtk.Image.new_from_pixbuf(pb))
            b.set_tooltip_text(os.path.basename(p))
            b.connect("clicked", lambda _b, p=p: apply(p))
            buttons.append((b, p))
            flow.add(b)
        inner.pack_start(flow, False, False, 0)

    section("Stoa wallpapers", WALLPAPERS)
    section("Your pictures", recent_pictures())
    row = Gtk.Box(spacing=8)
    browse = ui.css(Gtk.Button(label="Browse…"), "f-ghost")

    def browse_clicked(*_):
        fc = Gtk.FileChooserDialog(title="Choose a picture", transient_for=dlg, action=Gtk.FileChooserAction.OPEN)
        fc.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Set as wallpaper", Gtk.ResponseType.OK)
        f = Gtk.FileFilter()
        f.set_name("Pictures")
        f.add_mime_type("image/*")
        fc.add_filter(f)
        if fc.run() == Gtk.ResponseType.OK:
            p = fc.get_filename()
            fc.destroy()
            apply(p)
        else:
            fc.destroy()

    browse.connect("clicked", browse_clicked)
    row.pack_start(browse, False, False, 0)
    row.pack_start(status, True, True, 0)
    area.pack_start(row, False, False, 0)
    dlg.add_button("Done", Gtk.ResponseType.CLOSE)
    mark(current_wallpaper())
    dlg.show_all()
    dlg.run()
    dlg.destroy()


MANUAL = os.path.expanduser("~/.config/stoa/display-manual")


def outputs():
    """Parse `wlr-randr` into [(name, [modes], current, preferred)]."""
    out = subprocess.run(["wlr-randr"], capture_output=True, text=True).stdout
    res, cur = [], None
    for line in out.splitlines():
        if line and not line.startswith(" "):
            cur = [line.split()[0], [], None, None]
            res.append(cur)
        elif cur and " px" in line:
            mode = line.split()[0]
            if mode not in cur[1]:
                cur[1].append(mode)
            if "current" in line:
                cur[2] = mode
            if "preferred" in line:
                cur[3] = mode
    return res


def display_dialog(parent):
    outs = outputs()
    dlg = Gtk.Dialog(title="Display", transient_for=parent, modal=True)
    dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Apply", Gtk.ResponseType.OK)
    box = dlg.get_content_area()
    box.set_spacing(10)
    box.set_border_width(16)
    if not outs:
        box.add(Gtk.Label(label="No display information available."))
    combos = []
    for name, modes, current, preferred in outs:
        box.add(ui.css(Gtk.Label(label=f"Screen {name}", xalign=0), "f-h2"))
        combo = Gtk.ComboBoxText()
        combo.append("auto", "Automatic (fit to screen / VM window)")
        for m in modes:
            combo.append(m, m.replace("x", " × ") + ("  (recommended)" if m == preferred else ""))
        combo.set_active_id("auto" if not os.path.exists(MANUAL) else (current or "auto"))
        box.add(combo)
        combos.append((name, combo))
    box.add(ui.css(Gtk.Label(label="Tip: in VirtualBox, VMware or Hyper-V choose Automatic and resize the VM window.",
                             xalign=0, wrap=True, max_width_chars=50), "f-muted"))
    dlg.show_all()
    if dlg.run() == Gtk.ResponseType.OK:
        auto = True
        for name, combo in combos:
            mode = combo.get_active_id()
            if mode == "auto":
                subprocess.run(["wlr-randr", "--output", name, "--preferred"])
            else:
                auto = False
                subprocess.run(["wlr-randr", "--output", name, "--mode", mode])
        os.makedirs(os.path.dirname(MANUAL), exist_ok=True)
        if auto:
            if os.path.exists(MANUAL):
                os.remove(MANUAL)
        else:
            open(MANUAL, "w").close()
    dlg.destroy()


TILES = [
    ("Display", "video-display", "display"),
    ("Network & Wi-Fi", "network-wireless", ["nm-connection-editor"]),
    ("Sound", "audio-volume-high", ["pavucontrol"]),
    ("Security", "security-high", ["stoa-protect"]),
    ("Accounts", "system-users", ["stoa-users"]),
    ("Bluetooth", "bluetooth", ["blueman-manager"]),
    ("Printers", "printer", ["system-config-printer"]),
    ("Scanner", "scanner", ["simple-scan"]),
    ("Wallpaper", "preferences-desktop-wallpaper", None),
    ("Software & Updates", "system-software-update", ["stoa-store"]),
    ("Install updates now", "software-update-available", ["stoa-updates"]),
    ("Files", "system-file-manager", ["thunar"]),
    ("Terminal", "utilities-terminal", ["foot"]),
    ("Task Manager", "utilities-system-monitor", ["stoa-taskmgr"]),
    ("About this PC", "computer", ["stoa-taskmgr", "system"]),
]


def main():
    ui.apply_css()
    if len(sys.argv) > 2 and sys.argv[1] == "set-wallpaper":
        err = set_wallpaper(os.path.abspath(sys.argv[2]))
        if err:
            if shutil.which("notify-send"):
                ui.spawn("notify-send", "-a", "Stoa", "-i", "dialog-warning", "Wallpaper not changed", err)
            sys.exit(err)
        return
    if len(sys.argv) > 1 and sys.argv[1] == "wallpaper":
        pick_wallpaper(None)
        return
    if len(sys.argv) > 1 and sys.argv[1] == "display":
        display_dialog(None)
        return
    if len(sys.argv) > 1 and sys.argv[1] in ("personalise", "personalize"):
        pick_wallpaper(None)
        return
    if len(sys.argv) > 1 and sys.argv[1] in ("about", "system"):
        os.execvp("stoa-taskmgr", ["stoa-taskmgr", "system"])
    if len(sys.argv) > 1 and sys.argv[1] == "accounts":
        os.execvp("stoa-users", ["stoa-users"])
    win = Gtk.Window(title="Stoa Settings")
    win.set_default_size(*ui.fit_size(640, 460))
    win.set_icon_name("stoa")
    win.connect("destroy", Gtk.main_quit)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
    box.set_border_width(18)
    win.add(box)
    box.pack_start(ui.css(Gtk.Label(label="Settings", xalign=0), "f-title"), False, False, 0)
    grid = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=3, min_children_per_line=3,
                       homogeneous=True, row_spacing=10, column_spacing=10)
    for label, icon, cmd in TILES:
        b = ui.css(Gtk.Button(), "f-card")
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG)
        img.set_pixel_size(40)
        v.pack_start(img, False, False, 0)
        v.pack_start(Gtk.Label(label=label), False, False, 0)
        b.add(v)
        if cmd == "display":
            b.connect("clicked", lambda *_: display_dialog(win))
        elif cmd:
            b.connect("clicked", lambda _b, c=cmd: ui.spawn(*c))
        else:
            b.connect("clicked", lambda *_: pick_wallpaper(win))
        grid.add(b)
    box.pack_start(grid, True, True, 0)
    ver = open("/usr/share/stoa/VERSION").read().strip() if os.path.exists("/usr/share/stoa/VERSION") else "?"
    kernel = os.uname().release
    kname = f"Stoa kernel {kernel}" if "stoa" in kernel else f"Linux {kernel}"
    box.pack_start(ui.css(Gtk.Label(label=f"Stoa {ver}  ·  {kname}", xalign=0), "f-muted"),
                   False, False, 0)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
