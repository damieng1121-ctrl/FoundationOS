#!/usr/bin/env python3
"""Privileged half of fpkg. Runs as root (via sudo/pkexec) and only performs a fixed set of
operations. Repositories are only ever taken from the system catalog, never from arguments."""
import json
import os
import pwd
import re
import subprocess
import sys
import urllib.request

import yaml

CATALOG = "/usr/share/stoa/catalog.yaml"
PKG_RE = re.compile(r"^[a-z0-9][a-z0-9.+\-]*(:[a-z0-9]+)?$")
ENV = {**os.environ, "DEBIAN_FRONTEND": "noninteractive", "PATH": "/usr/sbin:/usr/bin:/sbin:/bin"}
APT = ["apt-get", "-y", "-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold"]


def sh(cmd):
    print("# " + " ".join(cmd), flush=True)
    r = subprocess.run(cmd, env=ENV)
    if r.returncode:
        sys.exit(r.returncode)


def pkgs(names):
    for n in names:
        if not PKG_RE.match(n):
            sys.exit(f"invalid package name: {n}")
    return names


def repo_add(app_id):
    with open(CATALOG) as f:
        apps = {a["id"]: a for a in yaml.safe_load(f)["apps"]}
    app = apps.get(app_id)
    if not app or app.get("source") != "apt-repo":
        sys.exit(f"{app_id} has no repository in the catalog")
    repo = app["repo"]
    os.makedirs("/etc/apt/keyrings", mode=0o755, exist_ok=True)
    req = urllib.request.Request(repo["key"], headers={"User-Agent": "fpkg-helper"})
    with urllib.request.urlopen(req, timeout=60) as r:
        key = r.read()
    keyring = f"/etc/apt/keyrings/{repo['keyring']}"
    if key.lstrip().startswith(b"-----BEGIN"):
        subprocess.run(["gpg", "--batch", "--yes", "--dearmor", "-o", keyring], input=key, check=True)
    else:
        with open(keyring, "wb") as f:
            f.write(key)
    os.chmod(keyring, 0o644)
    with open(f"/etc/apt/sources.list.d/{repo['list']}", "w") as f:
        f.write(repo["line"].replace("@KEYRING@", keyring) + "\n")
    if repo.get("pin"):
        with open(f"/etc/apt/preferences.d/fpkg-{app_id}", "w") as f:
            f.write(repo["pin"])
    sh(["apt-get", "update"])


def kernel_headers():
    """Headers (and DKMS) for the running kernel, so drivers can be built for it. True if available."""
    release = os.uname().release
    if os.path.isdir(f"/lib/modules/{release}/build"):
        sh(APT + ["install", "dkms"])
        return True
    if "stoa" in release:
        import glob
        debs = sorted(glob.glob(f"/usr/share/stoa/kernel/linux-headers-{release}_*.deb"))
        if debs:
            sh(APT + ["install", "dkms", debs[-1]])
            return True
        return False
    return subprocess.run(APT + ["install", "dkms", f"linux-headers-{release}"], env=ENV).returncode == 0


def install_razer():
    """Razer keyboards, mice and headsets: OpenRazer (driver + daemon) and Polychromatic (the settings app)."""
    sh(["apt-get", "update"])
    if not kernel_headers():
        sys.exit(f"Can't build the Razer driver for this kernel ({os.uname().release}): its headers aren't "
                 "available. Restart into the Ubuntu kernel (Advanced options at boot) and try again.")
    sh(APT + ["install", "openrazer-meta"])  # driver (built with DKMS), daemon, Python library
    # Polychromatic, the Razer settings app, comes from its developers' Ubuntu PPA.
    r = subprocess.run(["add-apt-repository", "-y", "ppa:polychromatic/stable"], env=ENV)
    if r.returncode == 0 and subprocess.run(APT + ["install", "polychromatic"], env=ENV).returncode == 0:
        print("Polychromatic installed.", flush=True)
    else:
        print("note: Polychromatic couldn't be added; use OpenRGB from the Stoa Store for lighting.", flush=True)
    # The OpenRazer daemon runs in each person's session; start it for every account, now and future ones.
    subprocess.run(["systemctl", "--global", "enable", "openrazer-daemon.service"], env=ENV)
    # Load the drivers now and re-bind devices that are already plugged in (no need to replug).
    for mod in ("razerkbd", "razermouse", "razerkraken", "razeraccessory"):
        subprocess.run(["modprobe", mod], env=ENV, capture_output=True)
    subprocess.run(["udevadm", "trigger", "--subsystem-match=hid", "--action=add"], env=ENV)
    uid = os.environ.get("PKEXEC_UID") or os.environ.get("SUDO_UID")
    if uid:
        import pwd
        user = pwd.getpwuid(int(uid)).pw_name
        subprocess.run(["usermod", "-aG", "plugdev", user], env=ENV)


def install_drivers():
    """Recommended graphics (and other) drivers via ubuntu-drivers. NVIDIA's driver is built for the
    running kernel with DKMS, so the Stoa kernel's headers (shipped in /usr/share/stoa/kernel) go first."""
    sh(["apt-get", "update"])
    sh(APT + ["install", "ubuntu-drivers-common"])
    if not kernel_headers():
        print(f"note: no headers for {os.uname().release}; NVIDIA's driver will work after restarting into "
              "the Ubuntu kernel (Advanced options at boot)", flush=True)
    r = subprocess.run(["ubuntu-drivers", "list"], env=ENV, capture_output=True, text=True)
    print(r.stdout.strip() or "No extra drivers are needed for this computer.", flush=True)
    if r.stdout.strip():
        sh(["ubuntu-drivers", "install"])


# Drives Stoa can open at start-up: (filesystem type to mount with, options). @UID@/@GID@ = the person asking.
DRIVE_FS = {
    "ntfs": ("ntfs3", "uid=@UID@,gid=@GID@,umask=022,windows_names,prealloc,nofail,x-gvfs-show"),
    "exfat": ("exfat", "uid=@UID@,gid=@GID@,umask=022,nofail,x-gvfs-show"),
    "ext4": ("ext4", "defaults,nofail,x-gvfs-show"),
    "btrfs": ("btrfs", "defaults,nofail,x-gvfs-show"),
    "xfs": ("xfs", "defaults,nofail,x-gvfs-show"),
}


def mount_drive(uuid):
    """Open a data drive (e.g. a Windows games drive) at /mnt/<name> now and at every start-up."""
    if not re.fullmatch(r"[0-9A-Fa-f-]{4,40}", uuid):
        sys.exit("invalid drive id")
    dev = os.path.realpath(f"/dev/disk/by-uuid/{uuid}")
    if not os.path.exists(dev):
        dev = subprocess.run(["blkid", "-U", uuid], capture_output=True, text=True, env=ENV).stdout.strip()
    if not dev or not os.path.exists(dev):
        sys.exit("That drive isn't connected.")
    r = subprocess.run(["lsblk", "-J", "-n", "-o", "PATH,FSTYPE,LABEL,MOUNTPOINT,PARTTYPENAME", dev],
                       capture_output=True, text=True, env=ENV)
    info = (json.loads(r.stdout or "{}").get("blockdevices") or [{}])[0]
    for key in ("fstype", "label"):  # lsblk relies on udev; ask the drive itself if udev hasn't seen it yet
        if not info.get(key):
            info[key] = subprocess.run(["blkid", "-s", "TYPE" if key == "fstype" else "LABEL", "-o", "value", dev],
                                       capture_output=True, text=True, env=ENV).stdout.strip() or None
    fs = info.get("fstype") or ""
    if fs not in DRIVE_FS:
        sys.exit(f"Stoa can't open {fs or 'this kind of'} drives automatically.")
    if info.get("mountpoint") in ("/", "/boot", "/boot/efi", "/home", "[SWAP]") or "EFI" in (info.get("parttypename") or ""):
        sys.exit("That's one of Stoa's own drives.")
    uid = int(os.environ.get("PKEXEC_UID") or os.environ.get("SUDO_UID") or 1000)
    gid = pwd.getpwuid(uid).pw_gid
    fstab = open("/etc/fstab").read() if os.path.exists("/etc/fstab") else ""
    m = re.search(rf"^UUID={re.escape(uuid)}\s+(\S+)", fstab, re.M | re.I)
    if m:
        mp = m.group(1)
    else:
        name = re.sub(r"[^A-Za-z0-9_.-]+", "-", info.get("label") or "").strip("-.") or f"drive-{uuid[:8].lower()}"
        mp, n = f"/mnt/{name}", 2
        while os.path.exists(mp) and (os.path.ismount(mp) or os.listdir(mp)):
            mp, n = f"/mnt/{name}-{n}", n + 1
        kind, opts = DRIVE_FS[fs]
        opts = opts.replace("@UID@", str(uid)).replace("@GID@", str(gid))
        with open("/etc/fstab", "a") as f:
            f.write(f"{'' if fstab.endswith(chr(10)) or not fstab else chr(10)}"
                    f"# {info.get('label') or uuid}: opened at start-up by Stoa\n"
                    f"UUID={uuid}\t{mp}\t{kind}\t{opts}\t0\t0\n")
    if info.get("mountpoint") and info["mountpoint"] != mp:
        subprocess.run(["umount", dev], env=ENV)  # it was opened temporarily (Files); reopen it in its permanent place
    os.makedirs(mp, exist_ok=True)
    subprocess.run(["systemctl", "daemon-reload"], env=ENV, capture_output=True)
    if not os.path.ismount(mp):
        r = subprocess.run(["mount", mp], capture_output=True, text=True, env=ENV)
        if r.returncode:
            log = subprocess.run(["dmesg"], capture_output=True, text=True).stdout[-3000:].lower()
            if fs == "ntfs" and any(w in (r.stderr.lower() + log) for w in ("dirty", "hibernat", "chkdsk", "force")):
                print(mp)
                sys.exit("Windows didn't fully shut down this drive, so it can't be opened safely yet. Start Windows, "
                         "turn off Fast Startup (Control Panel > Power Options > Choose what the power buttons do), "
                         "then choose Shut down. Stoa will open the drive next time it starts.")
            print(mp)
            sys.exit((r.stderr or "The drive couldn't be opened.").strip())
    print(mp)


def _dev_for(uuid):
    if not re.fullmatch(r"[0-9A-Fa-f-]{4,40}", uuid):
        sys.exit("invalid drive id")
    dev = os.path.realpath(f"/dev/disk/by-uuid/{uuid}")
    if not os.path.exists(dev):
        dev = subprocess.run(["blkid", "-U", uuid], capture_output=True, text=True, env=ENV).stdout.strip()
    return dev if dev and os.path.exists(dev) else None


def mount_ro(uuids):
    """Open drives read-only for Move from Windows: prints 'UUID MOUNTPOINT' per drive. Nothing is ever written,
    so it also works when Windows was left hibernated (Fast Startup)."""
    uid = int(os.environ.get("PKEXEC_UID") or os.environ.get("SUDO_UID") or 1000)
    gid = pwd.getpwuid(uid).pw_gid
    for uuid in uuids:
        dev = _dev_for(uuid)
        if not dev:
            continue
        cur = subprocess.run(["findmnt", "-n", "-o", "TARGET", "--source", dev], capture_output=True, text=True,
                             env=ENV).stdout.split("\n")[0].strip()
        if cur:
            print(uuid, cur)
            continue
        fs = subprocess.run(["blkid", "-s", "TYPE", "-o", "value", dev], capture_output=True, text=True,
                            env=ENV).stdout.strip()
        mp = f"/run/stoa/windows-{uuid[:8].lower()}"
        os.makedirs(mp, exist_ok=True)
        tries = ([["-t", "ntfs3", "-o", f"ro,uid={uid},gid={gid},umask=022"],
                  ["-t", "ntfs3", "-o", f"ro,force,uid={uid},gid={gid},umask=022"]] if fs == "ntfs" else
                 [["-o", "ro"]])
        for opts in tries:
            if subprocess.run(["mount", *opts, dev, mp], capture_output=True, env=ENV).returncode == 0:
                print(uuid, mp)
                break
        else:
            os.rmdir(mp)


def umount_ro(uuids):
    for uuid in uuids:
        mp = f"/run/stoa/windows-{uuid[:8].lower()}"
        if re.fullmatch(r"[0-9A-Fa-f-]{4,40}", uuid) and os.path.ismount(mp):
            subprocess.run(["umount", mp], env=ENV)
            os.rmdir(mp)


def main():
    if os.geteuid() != 0:
        sys.exit("fpkg-helper must run as root")
    if len(sys.argv) < 2:
        sys.exit("usage: fpkg-helper <op> [args]")
    op, args = sys.argv[1], sys.argv[2:]
    if op == "repo-add":
        repo_add(args[0])
    elif op == "apt-install":
        sh(["apt-get", "update"])
        sh(APT + ["install", *pkgs(args)])
    elif op == "apt-remove":
        sh(APT + ["remove", *pkgs(args)])
        sh(APT + ["autoremove"])
    elif op == "deb-install":
        path = os.path.realpath(args[0])
        if not path.endswith(".deb") or not os.path.isfile(path):
            sys.exit("not a .deb file")
        sh(["apt-get", "update"])
        sh(APT + ["install", path])
    elif op == "upgrade":
        sh(["apt-get", "update"])
        sh(APT + ["full-upgrade"])
        sh(APT + ["autoremove"])
        if os.path.exists("/usr/bin/flatpak"):
            subprocess.run(["flatpak", "update", "--system", "-y", "--noninteractive"], env=ENV)
    elif op == "drivers":
        install_drivers()
    elif op == "razer":
        install_razer()
    elif op == "cleanup":  # Stoa Doctor: free space - downloaded update files, old logs, unused Flatpak runtimes
        subprocess.run(["apt-get", "clean"], env=ENV)
        subprocess.run(APT + ["autoremove", "--purge"], env=ENV)
        subprocess.run(["journalctl", "--vacuum-size=200M"], env=ENV, capture_output=True)
        subprocess.run(["flatpak", "uninstall", "--system", "--unused", "-y", "--noninteractive"], env=ENV,
                       capture_output=True)
        for f in os.listdir("/var/crash") if os.path.isdir("/var/crash") else []:
            os.remove(os.path.join("/var/crash", f))
    elif op == "repair":  # Stoa Doctor: finish an interrupted install or update
        sh(["dpkg", "--configure", "-a"])
        sh(APT + ["install", "-f"])
    elif op == "restart-service" and args:  # Stoa Doctor: restart failed system services
        for unit in args:
            if not re.fullmatch(r"[A-Za-z0-9@._:-]+", unit):
                sys.exit(f"invalid service name: {unit}")
            subprocess.run(["systemctl", "reset-failed", unit], env=ENV)
            subprocess.run(["systemctl", "restart", unit], env=ENV)
    elif op == "mount-ro" and args:
        mount_ro(args)
    elif op == "umount-ro" and args:
        umount_ro(args)
    elif op == "reboot-windows":
        cfg = open("/boot/grub/grub.cfg", errors="replace").read()
        m = re.search(r"^menuentry '([^']*Windows[^']*)'", cfg, re.M)
        if not m:
            sys.exit("Windows isn't in the start-up menu. Run: sudo update-grub")
        sh(["grub-reboot", m.group(1)])
        sh(["systemctl", "reboot"])
    elif op == "mount-drive" and args:
        mount_drive(args[0])
    elif op == "refresh":
        sh(["apt-get", "update"])
    else:
        sys.exit(f"unknown operation {op}")


if __name__ == "__main__":
    main()
    if os.path.exists("/usr/lib/stoa/app-names"):
        subprocess.run(["/usr/lib/stoa/app-names"])
