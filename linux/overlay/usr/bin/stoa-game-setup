#!/usr/bin/env python3
"""One-click game set-ups that need more than installing an app.

  stoa-game-setup jedi-academy          Jedi Academy on OpenJK (modern engine), using your Steam/GOG game files
  stoa-game-setup mod-organizer [game]  Mod Organizer 2 for Fallout, Skyrim and more (via MO2-LINT, for Steam/Heroic)
  stoa-game-setup jka-mod [FILE]        install a Jedi Academy mod: a ModDB .exe installer, .zip/.7z/.rar or .pk3
                                        (e.g. Movie Duels 2), with its own entry in the Stoa menu
  stoa-game-setup steam-drives          find Steam games already installed on other drives (e.g. from Windows)
                                        and add them to Steam, so they show as installed
  stoa-game-setup remove <name>         undo jedi-academy or mod-organizer

Runs as the user; only opening a drive at start-up asks for an administrator password.
"""
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import random
import tempfile
import time
import urllib.request

HOME = os.path.expanduser("~")
DATA = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share")
APPS = os.path.join(DATA, "applications")
GAMES = os.path.join(DATA, "stoa/games")
OPENJK_DIR = os.path.join(GAMES, "openjk")
OPENJK_URL = "https://github.com/JACoders/OpenJK/releases/download/latest/OpenJK-linux-x86_64.tar.gz"
JKA_MODS = os.path.join(DATA, "openjk/base")  # OpenJK's own home folder: mods (.pk3) go here
MO2_URL = "https://github.com/Furglitch/modorganizer2-linux-installer/releases/latest/download/mo2-lint"
MO2_BIN = os.path.join(HOME, ".local/lib/stoa/mo2-lint")
MO2_GAMES = [  # (MO2-LINT id, name people know it by)
    ("fallout4", "Fallout 4"), ("falloutnv", "Fallout: New Vegas"), ("fallout3", "Fallout 3"),
    ("fallout3_goty", "Fallout 3 - Game of the Year Edition"), ("falloutlondon", "Fallout London"),
    ("skyrim_se", "Skyrim Special Edition / Anniversary"), ("skyrim", "Skyrim (2011)"),
    ("oblivion", "Oblivion"), ("morrowind", "Morrowind"), ("starfield", "Starfield"),
    ("cyberpunk2077", "Cyberpunk 2077"), ("baldursgate3", "Baldur's Gate 3"), ("witcher3", "The Witcher 3"),
    ("dragonage", "Dragon Age: Origins"), ("valheim", "Valheim"), ("subnautica", "Subnautica"),
]
GUI = bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")) and shutil.which("zenity")


# ------------------------------------------------------------------ helpers

def say(msg):
    print(msg, flush=True)


def info(msg, title="Game set-up"):
    say(msg)
    if GUI:
        subprocess.run(["zenity", "--info", "--no-wrap", f"--title={title}", f"--text={msg}"])


def fail(msg):
    print(f"error: {msg}", file=sys.stderr, flush=True)
    if GUI:
        subprocess.run(["zenity", "--error", "--no-wrap", "--title=Game set-up", f"--text={msg}"])
    sys.exit(1)


def download(url, dest):
    say(f"Downloading {url.rsplit('/', 1)[-1]}...")
    req = urllib.request.Request(url, headers={"User-Agent": "stoa-game-setup"})
    try:
        with urllib.request.urlopen(req, timeout=120) as r, open(dest, "wb") as f:
            shutil.copyfileobj(r, f)
    except OSError as e:
        fail(f"Couldn't download {url}\n{e}\nCheck the internet connection and try again.")


def desktop(file_id, name, exec_, icon, comment="", categories="Game;", workdir=None):
    os.makedirs(APPS, exist_ok=True)
    lines = ["[Desktop Entry]", "Type=Application", f"Name={name}", f"Exec={exec_}", f"Icon={icon}",
             f"Comment={comment}", f"Categories={categories}", "X-Stoa-GameSetup=true"]
    if workdir:
        lines.append(f"Path={workdir}")
    with open(os.path.join(APPS, f"{file_id}.desktop"), "w") as f:
        f.write("\n".join(lines) + "\n")


def refresh_menu():
    if shutil.which("update-desktop-database"):
        subprocess.run(["update-desktop-database", APPS], capture_output=True)


def steam_libraries():
    """Every Steam library folder (Flatpak and regular Steam, extra drives included)."""
    roots = [os.path.join(HOME, ".var/app/com.valvesoftware.Steam/.local/share/Steam"),
             os.path.join(DATA, "Steam"), os.path.join(HOME, ".steam/steam")]
    libs = []
    for root in roots:
        if not os.path.isdir(root):
            continue
        libs.append(root)
        vdf = os.path.join(root, "steamapps/libraryfolders.vdf")
        if os.path.exists(vdf):
            with open(vdf, errors="replace") as f:
                libs += re.findall(r'"path"\s+"([^"]+)"', f.read())
    seen, out = set(), []
    for lib in libs:
        real = os.path.realpath(lib)
        if real not in seen and os.path.isdir(real):
            seen.add(real)
            out.append(real)
    return out


# ------------------------------------------------------------ Jedi Academy

def find_jka_base():
    """The game's base folder (holding assets0.pk3), from Steam, GOG/Heroic or ~/Games."""
    candidates = [os.path.join(lib, "steamapps/common/Jedi Academy/GameData/base") for lib in steam_libraries()]
    candidates += glob.glob(os.path.join(HOME, "Games/**/GameData/base"), recursive=True)
    for c in candidates:
        if os.path.exists(os.path.join(c, "assets0.pk3")):
            return c
    return None


def ask_for_jka_base():
    if not GUI:
        return None
    r = subprocess.run(["zenity", "--file-selection", "--directory",
                        "--title=Choose the Jedi Academy GameData folder (it contains a 'base' folder)"],
                       capture_output=True, text=True)
    path = r.stdout.strip()
    for c in (os.path.join(path, "base"), path):
        if os.path.exists(os.path.join(c, "assets0.pk3")):
            return c
    return None


def setup_jedi_academy():
    base = find_jka_base()
    if not base:
        say("Jedi Academy's game files weren't found in Steam.")
        if GUI and subprocess.run(["zenity", "--question", "--no-wrap", "--title=Jedi Academy",
                                   "--ok-label=Choose folder", "--cancel-label=Cancel",
                                   "--text=Stoa couldn't find Jedi Academy.\n\nInstall it in Steam first "
                                   "(Star Wars Jedi Knight: Jedi Academy), then run this again - or choose "
                                   "the game folder yourself if it's somewhere else (GOG, a disc install)."]
                                  ).returncode == 0:
            base = ask_for_jka_base()
        if not base:
            fail("Jedi Academy's game files (assets0.pk3) weren't found.\n"
                 "Install the game in Steam, then run the set-up again.")
    say(f"Using game files in {base}")

    with tempfile.TemporaryDirectory() as td:
        archive = os.path.join(td, "openjk.tar.gz")
        download(OPENJK_URL, archive)
        new = OPENJK_DIR + ".new"
        shutil.rmtree(new, ignore_errors=True)
        os.makedirs(new)
        with tarfile.open(archive) as t:
            t.extractall(new, filter="data")
    # Some builds put everything in a JediAcademy/ folder.
    inner = os.path.join(new, "JediAcademy")
    if os.path.isdir(inner) and not os.path.exists(os.path.join(new, "openjk.x86_64")):
        for name in os.listdir(inner):
            shutil.move(os.path.join(inner, name), new)
    for exe in ("openjk.x86_64", "openjk_sp.x86_64"):
        if not os.path.exists(os.path.join(new, exe)):
            shutil.rmtree(new, ignore_errors=True)
            fail(f"The OpenJK download didn't contain {exe}.")
    shutil.rmtree(OPENJK_DIR, ignore_errors=True)
    os.rename(new, OPENJK_DIR)

    # Link the original game data in, so nothing is copied and Steam can still update it.
    jbase = os.path.join(OPENJK_DIR, "base")
    os.makedirs(jbase, exist_ok=True)
    for pk3 in glob.glob(os.path.join(base, "assets*.pk3")):
        dst = os.path.join(jbase, os.path.basename(pk3))
        if not os.path.exists(dst):
            os.symlink(pk3, dst)
    os.makedirs(JKA_MODS, exist_ok=True)
    with open(os.path.join(JKA_MODS, "PUT MODS HERE.txt"), "w") as f:
        f.write("Put Jedi Academy mods (.pk3 files) in this folder, then start the game.\n"
                "Single-player and multiplayer both load them. Remove a .pk3 to turn that mod off.\n")
    for exe in ("openjk.x86_64", "openjk_sp.x86_64"):
        os.chmod(os.path.join(OPENJK_DIR, exe), 0o755)

    icon = "applications-games"
    desktop("stoa-jka-sp", "Jedi Academy", os.path.join(OPENJK_DIR, "openjk_sp.x86_64"), icon,
            "Star Wars Jedi Knight: Jedi Academy (single-player, OpenJK)", workdir=OPENJK_DIR)
    desktop("stoa-jka-mp", "Jedi Academy Multiplayer", os.path.join(OPENJK_DIR, "openjk.x86_64"), icon,
            "Star Wars Jedi Knight: Jedi Academy (multiplayer, OpenJK)", workdir=OPENJK_DIR)
    desktop("stoa-jka-mods", "Jedi Academy Mods", f'xdg-open "{JKA_MODS}"', "folder-games",
            "Open the folder for Jedi Academy mods (.pk3)", categories="Game;")
    refresh_menu()
    info("Jedi Academy is ready.\n\n"
         "• Play: 'Jedi Academy' and 'Jedi Academy Multiplayer' in the Stoa menu.\n"
         "• Mods: open 'Jedi Academy Mods' and drop .pk3 files into that folder.\n"
         "• Run this set-up again any time to update OpenJK.", "Jedi Academy")


def remove_jedi_academy():
    shutil.rmtree(OPENJK_DIR, ignore_errors=True)
    for fid in ("stoa-jka-sp", "stoa-jka-mp", "stoa-jka-mods"):
        p = os.path.join(APPS, f"{fid}.desktop")
        if os.path.exists(p):
            os.remove(p)
    refresh_menu()
    say(f"Removed OpenJK. Your mods and saves are kept in {os.path.dirname(JKA_MODS)}.")


# ------------------------------------------------------------ Jedi Academy mods (ModDB installers and archives)

JKA_WINE = os.path.join(GAMES, "jka-wine")          # Windows set-up for mods that bring their own Windows engine
JKA_MOD_STATE = os.path.join(GAMES, "jka-mods.json")
JUNK_NAMES = {"$pluginsdir", "$temp", "$_outdir", "[nsis].nsi", "uninstall.exe", "uninst.exe", "unins000.exe",
              "unins000.dat", "$r0", "$0"}


def tool(*names):
    for n in names:
        if shutil.which(n):
            return n
    return None


def unpack(path, dest):
    """Unpack an archive or a Windows installer without running it. True if anything came out."""
    os.makedirs(dest, exist_ok=True)
    low = path.lower()
    tries = []
    if low.endswith(".exe"):
        if tool("innoextract"):
            tries.append(["innoextract", "--silent", "--extract", "--output-dir", dest, path])  # Inno Setup
        if tool("7z"):
            tries.append(["7z", "x", "-y", f"-o{dest}", path])                                  # NSIS, 7-Zip SFX
        if tool("unar"):
            tries.append(["unar", "-q", "-f", "-o", dest, path])                                # RAR/ZIP SFX
    else:
        if tool("7z"):
            tries.append(["7z", "x", "-y", f"-o{dest}", path])
        if tool("unar"):
            tries.append(["unar", "-q", "-f", "-o", dest, path])
        if low.endswith(".zip") and tool("unzip"):
            tries.append(["unzip", "-q", "-o", path, "-d", dest])
    for cmd in tries:
        shutil.rmtree(dest, ignore_errors=True)
        os.makedirs(dest)
        r = subprocess.run(cmd, capture_output=True, text=True)
        files = [f for _r, _d, fs in os.walk(dest) for f in fs]
        if r.returncode == 0 and any(f.lower().endswith((".pk3", ".bat", ".exe", ".dll", ".cfg")) for f in files):
            return True
    return False


def mod_root(staging):
    """The folder in an unpacked mod that corresponds to Jedi Academy's GameData folder."""
    for junk in os.listdir(staging):
        if junk.lower() in JUNK_NAMES:
            p = os.path.join(staging, junk)
            shutil.rmtree(p, ignore_errors=True) if os.path.isdir(p) else os.remove(p)
    # Explicit GameData folder anywhere near the top
    for cur, dirs, _f in os.walk(staging):
        if os.path.relpath(cur, staging).count(os.sep) > 4:
            dirs[:] = []
            continue
        for d in dirs:
            if d.lower() == "gamedata":
                return os.path.join(cur, d)
    # Installer layouts: Inno's app/, NSIS's $INSTDIR
    for d in ("app", "$INSTDIR", "$_OUTDIR"):
        if os.path.isdir(os.path.join(staging, d)):
            staging = os.path.join(staging, d)
    # A single wrapper folder (e.g. "Movie Duels 2/")
    while True:
        items = [i for i in os.listdir(staging) if not i.startswith(".")]
        if len(items) == 1 and os.path.isdir(os.path.join(staging, items[0])) and \
                not glob.glob(os.path.join(staging, items[0], "*.pk3")):
            staging = os.path.join(staging, items[0])
            continue
        break
    # Only .pk3 files at the top: it's a mod folder's contents; name it after the archive later
    return staging


def merge_tree(src, dst, record):
    """Copy src into dst (the game's GameData), never replacing the original game's files."""
    for cur, dirs, files in os.walk(src):
        rel = os.path.relpath(cur, src)
        out = os.path.normpath(os.path.join(dst, rel))
        os.makedirs(out, exist_ok=True)
        for f in files:
            target = os.path.join(out, f)
            if re.match(r"assets\d\.pk3$", f, re.I) and os.path.exists(target):
                continue
            shutil.copy2(os.path.join(cur, f), target)
            record.append(os.path.relpath(target, dst))


def bat_launch(gamedata, bat):
    """(exe, args) from a mod's Windows launcher .bat, e.g. 'openjk_sp.x86.exe +set fs_game MovieDuels'."""
    try:
        text = open(os.path.join(gamedata, bat), errors="replace").read()
    except OSError:
        return None
    for line in text.splitlines():
        m = re.search(r'"?([^"\s]*\.exe)"?(.*)$', line, re.I)
        if m and not line.strip().lower().startswith(("rem", "::")):
            exe = m.group(1).replace("\\", "/").lstrip("./")
            args = m.group(2).strip()
            if os.path.exists(os.path.join(gamedata, exe)):
                return exe, args
    return None


def pretty(name):
    name = re.sub(r"\.(bat|exe|pk3|zip|7z|rar)$", "", name, flags=re.I)
    name = re.sub(r"[_]+", " ", name).replace(" - ", " – ")
    return re.sub(r"\s+", " ", name).strip() or "Jedi Academy mod"


def jka_wine_env():
    env = dict(os.environ, WINEPREFIX=JKA_WINE, WINEDEBUG="-all", WINEDLLOVERRIDES="mscoree,mshtml=")
    if not os.path.exists(os.path.join(JKA_WINE, "system.reg")):
        say("Preparing Windows support for the mod (first time only)...")
        os.makedirs(JKA_WINE, exist_ok=True)
        subprocess.run(["wine", "wineboot", "-i"], env=env, capture_output=True)
    return env


def register_jka_path(env, gamedata):
    """Tell Windows installers where Jedi Academy is, the way a Windows PC would."""
    win = subprocess.run(["wine", "winepath", "-w", os.path.dirname(gamedata)], env=env, capture_output=True,
                         text=True).stdout.strip()
    for key in (r"HKLM\Software\LucasArts\Star Wars Jedi Knight Jedi Academy\1.0",
                r"HKLM\Software\Wow6432Node\LucasArts\Star Wars Jedi Knight Jedi Academy\1.0"):
        subprocess.run(["wine", "reg", "add", key, "/v", "Install Path", "/t", "REG_SZ", "/d", win, "/f"],
                       env=env, capture_output=True)
    return win


def snapshot(folder):
    out = {}
    for cur, _d, files in os.walk(folder):
        for f in files:
            p = os.path.join(cur, f)
            try:
                out[os.path.relpath(p, folder)] = os.path.getmtime(p)
            except OSError:
                pass
    return out


def setup_jka_mod(path=None):
    if not path:
        if not GUI:
            fail("Name the mod file: stoa-game-setup jka-mod ~/Downloads/<mod>.exe")
        r = subprocess.run(["zenity", "--file-selection", "--title=Choose the Jedi Academy mod you downloaded",
                            f"--filename={os.path.join(HOME, 'Downloads')}/",
                            "--file-filter=Jedi Academy mods | *.exe *.EXE *.zip *.7z *.rar *.pk3 *.ZIP *.PK3",
                            "--file-filter=All files | *"], capture_output=True, text=True)
        path = r.stdout.strip()
        if not path:
            return
    path = os.path.abspath(path)
    if not os.path.isfile(path):
        fail(f"{path} doesn't exist.")
    if shutil.which("stoa-protect"):  # scanned like every other download
        say(f"Checking {os.path.basename(path)} for viruses...")
        r = subprocess.run(["stoa-protect", "check", path], capture_output=True, text=True)
        if r.returncode == 1:
            fail(f"Stoa Protect found a virus in {os.path.basename(path)} and quarantined it, so it wasn't installed.")

    if path.lower().endswith(".pk3"):  # a simple mod: drop it in the mods folder
        os.makedirs(JKA_MODS, exist_ok=True)
        shutil.copy2(path, JKA_MODS)
        info(f"Added {os.path.basename(path)}. Start Jedi Academy to use it.", "Jedi Academy mod")
        return

    base = find_jka_base() or ask_for_jka_base()
    if not base:
        fail("Jedi Academy's game files weren't found. Install Jedi Academy in Steam first.")
    gamedata = os.path.dirname(base)
    say(f"Jedi Academy is in {gamedata}")
    before = snapshot(gamedata)
    record = []
    with tempfile.TemporaryDirectory(dir=os.path.join(HOME, ".cache")) as td:
        staging = os.path.join(td, "mod")
        say(f"Unpacking {os.path.basename(path)}...")
        if unpack(path, staging):
            root = mod_root(staging)
            if glob.glob(os.path.join(root, "*.pk3")) and not os.path.isdir(os.path.join(root, "base")) \
                    and os.path.basename(root) in ("mod", "app"):
                # loose .pk3 files: a mod folder named after the download
                target = re.sub(r"[^A-Za-z0-9_-]+", "", pretty(os.path.basename(path)).title()) or "Mod"
                merge_tree(root, os.path.join(gamedata, target), record)
                record = [os.path.join(target, r) for r in record]
            else:
                merge_tree(root, gamedata, record)
        elif path.lower().endswith(".exe"):
            # An installer Stoa can't unpack: run it, pointed at the game.
            env = jka_wine_env()
            win = register_jka_path(env, gamedata)
            info("The mod's installer opens next.\n\nIf it asks where Jedi Academy is installed, choose:\n\n"
                 f"    {win}\\GameData\n\n(it's under drive Z: in the folder list).", "Installing the mod")
            subprocess.run(["wine", path], env=env)
            subprocess.run(["wineserver", "-w"], env=env)
        else:
            fail(f"{os.path.basename(path)} couldn't be unpacked. It may be damaged - try downloading it again.")
    after = snapshot(gamedata)
    changed = sorted(p for p in after if p not in before or after[p] != before[p])
    if not changed:
        fail("The mod didn't add anything to Jedi Academy. If its installer asked for a folder, run this again and "
             "choose the GameData folder it shows you.")

    # How to start it: the mod's own launcher (.bat), else OpenJK with the mod folder.
    top = sorted({c.split(os.sep)[0] for c in changed})
    mod_dirs = [d for d in top if os.path.isdir(os.path.join(gamedata, d)) and d.lower() != "base"]
    bats = [c for c in changed if c.lower().endswith(".bat") and os.sep not in c]
    launch = next((bat_launch(gamedata, b) + (b,) for b in bats if bat_launch(gamedata, b)), None)
    fs_game = None
    if launch:
        m = re.search(r'fs_game\s+"?([^"\s]+)"?', launch[1])
        fs_game = m.group(1) if m else None
    fs_game = fs_game or (mod_dirs[0] if mod_dirs else None)
    mod_dir = os.path.join(gamedata, fs_game) if fs_game else None
    windows_code = bool(mod_dir) and bool(glob.glob(os.path.join(mod_dir, "*.dll"))) and \
        not glob.glob(os.path.join(mod_dir, "*.so"))
    name = pretty(launch[2]) if launch else re.sub(r"(?i)[ _-]*(setup|installer|install|full|all in one)\b", "",
                                                    pretty(os.path.basename(path))).strip() or pretty(fs_game or "")
    fid = "stoa-jka-mod-" + re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")

    if launch and (windows_code or not re.match(r"openjk", launch[0], re.I)):
        # The mod brings its own Windows engine or game code: run it exactly as on Windows.
        jka_wine_env()
        exe = os.path.join(gamedata, launch[0])
        how = "its own engine (Windows version, through Stoa's Windows support)"
        exec_ = (f'env WINEPREFIX="{JKA_WINE}" WINEDEBUG=-all wine "{exe}" {launch[1]}').strip()
    elif fs_game:
        if not os.path.exists(os.path.join(OPENJK_DIR, "openjk_sp.x86_64")):
            say("Setting up OpenJK first...")
            setup_jedi_academy()
        link = os.path.join(OPENJK_DIR, fs_game)
        if not os.path.exists(link):
            os.symlink(mod_dir, link)
        sp = not re.search(r"openjk\.|jamp", launch[0], re.I) if launch else True
        exe = os.path.join(OPENJK_DIR, "openjk_sp.x86_64" if sp else "openjk.x86_64")
        how = "OpenJK (native)"
        exec_ = f'"{exe}" +set fs_game {fs_game}'
    else:
        info(f"The mod was added to Jedi Academy's base folder ({len(changed)} files). Start Jedi Academy to use "
             "it.", "Jedi Academy mod")
        return
    desktop(fid, name, exec_, "applications-games", f"Jedi Academy mod - runs on {how}",
            workdir=os.path.dirname(exe))
    refresh_menu()
    state = {}
    try:
        state = json.load(open(JKA_MOD_STATE))
    except (OSError, ValueError):
        pass
    state[fid] = {"name": name, "gamedata": gamedata, "files": changed, "source": os.path.basename(path)}
    os.makedirs(GAMES, exist_ok=True)
    json.dump(state, open(JKA_MOD_STATE, "w"), indent=1)
    info(f"{name} is installed.\n\nStart it from the Stoa menu: '{name}'.\nIt runs on {how}.\n\n"
         f"To remove it: stoa-game-setup remove jka-mod", "Jedi Academy mod")


def remove_jka_mods():
    try:
        state = json.load(open(JKA_MOD_STATE))
    except (OSError, ValueError):
        say("No Jedi Academy mods were installed by Stoa.")
        return
    for fid, m in state.items():
        for rel in m["files"]:
            p = os.path.join(m["gamedata"], rel)
            if os.path.isfile(p) and not re.match(r"assets\d\.pk3$", os.path.basename(p), re.I):
                os.remove(p)
        for rel in sorted({os.path.dirname(r) for r in m["files"]}, key=len, reverse=True):
            d = os.path.join(m["gamedata"], rel)
            if rel and os.path.isdir(d) and not os.listdir(d):
                os.rmdir(d)
        p = os.path.join(APPS, f"{fid}.desktop")
        if os.path.exists(p):
            os.remove(p)
        say(f"Removed {m['name']}.")
    os.remove(JKA_MOD_STATE)
    for link in glob.glob(os.path.join(OPENJK_DIR, "*")):
        if os.path.islink(link) and not os.path.exists(link):
            os.remove(link)  # OpenJK's link to a removed mod folder
    refresh_menu()


# ------------------------------------------------------------ Mod Organizer 2

def get_mo2_lint():
    os.makedirs(os.path.dirname(MO2_BIN), exist_ok=True)
    tmp = MO2_BIN + ".download"
    download(MO2_URL, tmp)
    os.chmod(tmp, 0o755)
    os.replace(tmp, MO2_BIN)


def pick_game():
    if not GUI:
        fail("Name the game: stoa-game-setup mod-organizer <" + "|".join(g for g, _ in MO2_GAMES) + ">")
    args = ["zenity", "--list", "--title=Mod Organizer 2", "--width=460", "--height=520",
            "--text=Which game do you want to mod?\nIt must be installed in Steam (or Heroic) and "
            "started once first.", "--column=id", "--column=Game", "--hide-column=1", "--print-column=1"]
    for gid, name in MO2_GAMES:
        args += [gid, name]
    r = subprocess.run(args, capture_output=True, text=True)
    return r.stdout.strip().split("|")[0] or None


def setup_mod_organizer(game=None):
    game = game or pick_game()
    if not game:
        return
    names = dict(MO2_GAMES)
    get_mo2_lint()
    target = os.path.join(HOME, "Games/Mod Organizer", names.get(game, game).split(" / ")[0].replace(":", ""))
    script = (f'echo "Setting up Mod Organizer 2 for {names.get(game, game)}"; echo; '
              f'"{MO2_BIN}" install {game} "{target}" --script-extender; '
              'echo; echo "When it says it has finished: in Steam, open the game\'s Properties > Compatibility, '
              'tick Force a specific compatibility tool and choose the MO2 one. Launching the game from '
              'Steam then opens Mod Organizer."; echo; read -p "Press Enter to close" _')
    desktop(f"stoa-mo2-{game}", f"Mod Organizer setup: {names.get(game, game)}",
            f"stoa-game-setup mod-organizer {game}", "applications-games",
            "Set up or repair Mod Organizer 2 for this game")
    refresh_menu()
    if GUI and shutil.which("foot"):
        subprocess.run(["foot", "--title=Mod Organizer 2 set-up", "sh", "-c", script])
    else:
        subprocess.run(["sh", "-c", script])


def remove_mod_organizer():
    for p in glob.glob(os.path.join(APPS, "stoa-mo2-*.desktop")):
        os.remove(p)
    refresh_menu()
    if os.path.exists(MO2_BIN):
        say("Your Mod Organizer instances stay in ~/Games/Mod Organizer. To remove one completely, run:\n"
            f"  {MO2_BIN} uninstall")


# ------------------------------------------------------------ Steam libraries on other drives

STEAM_FLATPAK = "com.valvesoftware.Steam"
LIB_SKIP = {"windows", "$recycle.bin", "system volume information", "programdata", "recovery", "$windows.~bt",
            "$winreagent", "users", "appdata", "proc", "sys", "dev", "boot", "efi", "msocache", "perflogs",
            "lost+found", "snap", "intel", "amd", "nvidia", "drivers", "onedrivetemp"}
TEMP_FS = {"ntfs", "ntfs3", "fuseblk", "exfat", "vfat"}  # can't hold Proton's Windows settings folders


def steam_root():
    """(Steam's own folder, installed as Flatpak?) - the one holding libraryfolders.vdf."""
    for root, flat in ((os.path.join(HOME, ".var/app", STEAM_FLATPAK, ".local/share/Steam"), True),
                       (os.path.join(DATA, "Steam"), False), (os.path.join(HOME, ".steam/steam"), False)):
        if os.path.exists(os.path.join(root, "steamapps/libraryfolders.vdf")):
            return os.path.realpath(root), flat
    return None, False


def steam_installed():
    return shutil.which("steam") or subprocess.run(["flatpak", "info", STEAM_FLATPAK], capture_output=True).returncode == 0


def steam_running():
    return subprocess.run(["pgrep", "-x", "steam"], capture_output=True).returncode == 0 or \
        subprocess.run(["pgrep", "-f", "steamwebhelper"], capture_output=True).returncode == 0


def block_devices():
    r = subprocess.run(["lsblk", "-J", "-b", "-o", "PATH,TYPE,SIZE,FSTYPE,LABEL,UUID,MOUNTPOINT,PARTTYPENAME"],
                       capture_output=True, text=True)
    out, stack = [], list(json.loads(r.stdout or "{}").get("blockdevices") or [])
    while stack:
        d = stack.pop(0)
        stack[0:0] = d.get("children") or []
        out.append(d)
    return out


def drives_to_open(devs):
    """Data drives Stoa could open at start-up: not opened yet, or only opened for now from Files."""
    fstab = open("/etc/fstab").read() if os.path.exists("/etc/fstab") else ""
    out = []
    for d in devs:
        mp, uuid = d.get("mountpoint") or "", d.get("uuid") or ""
        if (d.get("fstype") not in ("ntfs", "exfat", "ext4", "btrfs", "xfs") or not uuid or int(d.get("size") or 0) < 8 * 2**30
                or re.search(r"EFI|reserved|recovery|swap", d.get("parttypename") or "", re.I)
                or re.search(rf"^UUID={re.escape(uuid)}\s", fstab, re.M | re.I)):
            continue
        if mp and not mp.startswith(("/media/", "/run/media/")):
            continue
        out.append(d)
    return out


def find_libraries(top, depth=4):
    """Steam library folders under a drive: ones with a steamapps folder holding installed games."""
    libs = []
    for cur, dirs, _files in os.walk(top):
        rel = os.path.relpath(cur, top)
        level = 0 if rel == "." else rel.count(os.sep) + 1
        if "steamapps" in dirs:
            sa = os.path.join(cur, "steamapps")
            if glob.glob(os.path.join(sa, "appmanifest_*.acf")) or os.path.exists(os.path.join(cur, "libraryfolder.vdf")):
                libs.append(cur)
            dirs[:] = []
            continue
        dirs[:] = [d for d in dirs if d.lower() not in LIB_SKIP and not d.startswith(".") and level < depth]
    return libs


def library_games(lib):
    games = {}
    for acf in glob.glob(os.path.join(lib, "steamapps/appmanifest_*.acf")):
        try:
            text = open(acf, errors="replace").read()
        except OSError:
            continue
        appid = re.search(r'"appid"\s+"(\d+)"', text)
        if appid:
            name = re.search(r'"name"\s+"([^"]*)"', text)
            size = re.search(r'"SizeOnDisk"\s+"(\d+)"', text)
            games[appid.group(1)] = (name.group(1) if name else appid.group(1), size.group(1) if size else "0")
    return games


def add_to_vdf(vdf, lib, games):
    """Add a library to Steam's list of library folders (Steam must be closed)."""
    text = open(vdf, errors="replace").read()
    if re.search(r'"path"\s+"' + re.escape(lib) + '"', text):
        return
    shutil.copyfile(vdf, vdf + ".stoa-backup")
    n = max([int(x) for x in re.findall(r'^\t"(\d+)"\s*$', text, re.M)] or [-1]) + 1
    own = os.path.join(lib, "libraryfolder.vdf")
    cid = re.search(r'"contentid"\s+"(-?\d+)"', open(own, errors="replace").read()) if os.path.exists(own) else None
    apps = "".join(f'\t\t\t"{a}"\t\t"{size}"\n' for a, (_n, size) in sorted(games.items(), key=lambda x: int(x[0])))
    block = (f'\t"{n}"\n\t{{\n\t\t"path"\t\t"{lib.replace(chr(92), chr(92) * 2)}"\n\t\t"label"\t\t""\n'
             f'\t\t"contentid"\t\t"{cid.group(1) if cid else random.randint(10**17, 9 * 10**18)}"\n'
             f'\t\t"totalsize"\t\t"0"\n\t\t"update_clean_bytes_tally"\t\t"0"\n\t\t"time_last_update_verified"\t\t"0"\n'
             f'\t\t"apps"\n\t\t{{\n{apps}\t\t}}\n\t}}\n')
    end = text.rstrip().rfind("}")
    with open(vdf + ".stoa-new", "w") as f:
        f.write(text[:end] + block + text[end:])
    os.replace(vdf + ".stoa-new", vdf)


def mount_fstype(path):
    best, fs = "", ""
    for line in open("/proc/self/mounts"):
        f = line.split()
        mp = f[1].replace("\\040", " ")
        if (path == mp or path.startswith(mp.rstrip("/") + "/")) and len(mp) >= len(best):
            best, fs = mp, f[2]
    return fs, best


def ask(question, title="Steam games on other drives"):
    if not GUI:
        return input(question + " [Y/n] ").strip().lower() in ("", "y", "yes")
    return subprocess.run(["zenity", "--question", "--no-wrap", f"--title={title}", f"--text={question}"]).returncode == 0


def setup_steam_drives():
    if not steam_installed():
        fail("Steam isn't installed yet. Install it from the Stoa Store, open it and sign in, then run this again.")
    root, flat = steam_root()
    if not root:
        fail("Open Steam and sign in once first (so it sets up its library), then run this again.")

    # 1. Drives that aren't opened at start-up yet - Steam can only see games on drives that are always there.
    devs = block_devices()
    todo = drives_to_open(devs)
    if todo:
        rows = []
        for d in todo:
            rows += ["TRUE", d["uuid"], d.get("label") or os.path.basename(d["path"]),
                     f"{int(d['size']) / 1e9:.0f} GB {d['fstype'].upper()}", d.get("mountpoint") or "not opened"]
        if GUI:
            r = subprocess.run(["zenity", "--list", "--checklist", "--title=Steam games on other drives",
                                "--width=620", "--height=360",
                                "--text=Stoa found these drives. Tick the ones with Steam games on them, and Stoa "
                                "will open them every time it starts\n(you'll be asked for your password once):",
                                "--column=", "--column=id", "--column=Drive", "--column=Size", "--column=Now",
                                "--hide-column=2", "--print-column=2", "--separator=|", *rows],
                               capture_output=True, text=True)
            chosen = [x for x in r.stdout.strip().split("|") if x]
        else:
            chosen = [d["uuid"] for d in todo if ask(f"Open {d.get('label') or d['path']} at every start-up?")]
        for uuid in chosen:
            say(f"Opening drive {uuid}...")
            r = subprocess.run(["pkexec", "/usr/lib/stoa/fpkg-helper", "mount-drive", uuid], capture_output=True, text=True)
            if r.returncode and r.returncode != 126:
                info((r.stderr or r.stdout).strip().splitlines()[-1] if (r.stderr or r.stdout).strip() else
                     "That drive couldn't be opened.", "Couldn't open a drive")
        devs = block_devices()

    # 2. Look for Steam libraries on every opened drive (other than Stoa's own).
    say("Looking for Steam games...")
    known = {os.path.realpath(p) for p in steam_libraries()}
    found = []
    tops = sorted({d["mountpoint"] for d in devs if d.get("mountpoint") and d["mountpoint"] not in
                   ("/", "/boot", "/boot/efi", "[SWAP]") and not d["mountpoint"].startswith(("/snap", "/var/snap"))})
    for top in tops:
        for lib in find_libraries(top):
            if os.path.realpath(lib) not in known and os.path.realpath(lib) != root:
                found.append(os.path.realpath(lib))
    if not found:
        info("Stoa didn't find any other Steam libraries.\n\nIf your games are on a drive that's switched off or "
             "unplugged, connect it and run this again. You can also add a folder yourself in Steam: "
             "Steam > Settings > Storage > Add drive.")
        return
    games = {lib: library_games(lib) for lib in found}
    total = sum(len(g) for g in games.values())
    listing = "\n".join(f"  {lib}  ({len(g)} game{'s' if len(g) != 1 else ''})" for lib, g in games.items())
    if not ask(f"Found {total} installed game{'s' if total != 1 else ''} in:\n{listing}\n\nAdd them to Steam?"):
        return

    # 3. Steam must be closed while its library list changes.
    if steam_running():
        if not ask("Steam is open. Close it now so Stoa can add the games? (Downloads in progress pause.)"):
            return
        if flat:
            subprocess.run(["flatpak", "kill", STEAM_FLATPAK], capture_output=True)
        else:
            subprocess.run(["steam", "-shutdown"], capture_output=True, timeout=30)
        for _ in range(30):
            if not steam_running():
                break
            time.sleep(1)
        if steam_running():
            fail("Steam didn't close. Quit it from its menu (Steam > Exit) and run this again.")

    notes = []
    for lib, g in games.items():
        fs, mp = mount_fstype(lib)
        if flat:  # let the Steam app see the drive
            subprocess.run(["flatpak", "override", "--user", f"--filesystem={mp if mp not in ('/', '/home') else lib}",
                            STEAM_FLATPAK], capture_output=True)
        if fs in TEMP_FS:
            # Proton keeps each Windows game's settings in compatdata, and Windows drives can't store them (the
            # names have characters Windows doesn't allow). Keep that folder on Stoa's own drive instead.
            compat = os.path.join(lib, "steamapps/compatdata")
            if os.path.isdir(compat) and not os.path.islink(compat) and not os.listdir(compat):
                os.rmdir(compat)
            if not os.path.exists(compat):
                target = os.path.join(root, "steamapps", "compatdata-other-drives",
                                      re.sub(r"[^A-Za-z0-9]+", "-", lib).strip("-"))
                os.makedirs(target, exist_ok=True)
                try:
                    os.symlink(target, compat)
                except OSError:
                    notes.append(f"{lib} is on a {fs} drive, which can't hold the settings Windows games need. "
                                 "If a game won't start, move it to Stoa's drive in Steam > Properties > "
                                 "Installed Files > Move install folder.")
        for vdf in (os.path.join(root, "steamapps/libraryfolders.vdf"), os.path.join(root, "config/libraryfolders.vdf")):
            if os.path.exists(vdf):
                add_to_vdf(vdf, lib, g)
        say(f"Added {lib}")
    names = sorted({n for g in games.values() for n, _s in g.values()})
    shown = ", ".join(names[:12]) + (f" and {len(names) - 12} more" if len(names) > 12 else "")
    msg = (f"Done - {total} game{'s' if total != 1 else ''} added to Steam: {shown}.\n\n"
           "Open Steam and they show as installed. The first time you press Play, Steam may check the files for a "
           "minute instead of downloading them again.\n\nGames made for Windows need Proton: in Steam > Settings > "
           "Compatibility, turn on \"Enable Steam Play for all other titles\". Games that have their own Linux "
           "version may download that version once.")
    if notes:
        msg += "\n\n" + "\n".join(notes)
    info(msg, "Steam games added")


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return
    if a[0] == "jedi-academy":
        setup_jedi_academy()
    elif a[0] == "mod-organizer":
        setup_mod_organizer(a[1] if len(a) > 1 else None)
    elif a[0] == "jka-mod":
        setup_jka_mod(a[1] if len(a) > 1 else None)
    elif a[0] == "steam-drives":
        setup_steam_drives()
    elif a[0] == "remove" and len(a) > 1:
        {"jedi-academy": remove_jedi_academy, "mod-organizer": remove_mod_organizer,
         "jka-mod": remove_jka_mods}.get(
            a[1], lambda: fail(f"unknown set-up {a[1]}"))()
    else:
        fail(f"unknown command: {' '.join(a)}")


if __name__ == "__main__":
    main()
