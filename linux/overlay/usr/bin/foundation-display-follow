#!/bin/sh
# Keep the desktop sized to the screen: follows VM window resizes (VirtualBox/VMware/QEMU send a new
# "preferred" resolution), monitor changes, and the real screen size in compatibility mode.
# Turned off while the user has picked a resolution in Settings (~/.config/foundation/display-manual).
manual="${XDG_CONFIG_HOME:-$HOME/.config}/foundation/display-manual"
while :; do
  if [ ! -e "$manual" ]; then
    if [ -n "$FOUNDATION_COMPAT" ] && [ -n "$FOUNDATION_X_DISPLAY" ]; then
      dims=$(DISPLAY="$FOUNDATION_X_DISPLAY" xdpyinfo 2>/dev/null | awk '/dimensions:/{print $2; exit}')
      cur=$(wlr-randr 2>/dev/null | awk '/\(current\)/{print $1; exit}')
      if [ -n "$dims" ] && [ "$dims" != "$cur" ]; then
        wlr-randr --output X11-1 --custom-mode "$dims" >/dev/null 2>&1
      fi
    else
      wlr-randr 2>/dev/null | awk '
        /^[^ ]/ { if (name != "" && pref != "" && pref != cur) print name; name=$1; pref=""; cur="" }
        /px/ && /preferred/ { pref=$1 }
        /px/ && /current/   { cur=$1 }
        END { if (name != "" && pref != "" && pref != cur) print name }' |
      while read -r out; do
        wlr-randr --output "$out" --preferred >/dev/null 2>&1
      done
    fi
  fi
  sleep 2
done
