#!/usr/bin/env python3
"""Foundation Settings hub."""
import os
import subprocess
import sys

sys.path.insert(0, "/usr/lib/foundation")
import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk  # noqa: E402

import foundation_ui as ui  # noqa: E402


def pick_wallpaper(parent):
    dlg = Gtk.FileChooserDialog(title="Choose a wallpaper", parent=parent, action=Gtk.FileChooserAction.OPEN)
    dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Set wallpaper", Gtk.ResponseType.OK)
    f = Gtk.FileFilter()
    f.add_mime_type("image/*")
    dlg.add_filter(f)
    if dlg.run() == Gtk.ResponseType.OK:
        path = dlg.get_filename()
        cfg = os.path.expanduser("~/.config/foundation")
        os.makedirs(cfg, exist_ok=True)
        with open(os.path.join(cfg, "wallpaper"), "w") as fh:
            fh.write(path)
        subprocess.run(["pkill", "-x", "swaybg"])
        ui.spawn("swaybg", "-m", "fill", "-i", path)
    dlg.destroy()


MANUAL = os.path.expanduser("~/.config/foundation/display-manual")


def outputs():
    """Parse `wlr-randr` into [(name, [modes], current, preferred)]."""
    out = subprocess.run(["wlr-randr"], capture_output=True, text=True).stdout
    res, cur = [], None
    for line in out.splitlines():
        if line and not line.startswith(" "):
            cur = [line.split()[0], [], None, None]
            res.append(cur)
        elif cur and " px" in line:
            mode = line.split()[0]
            if mode not in cur[1]:
                cur[1].append(mode)
            if "current" in line:
                cur[2] = mode
            if "preferred" in line:
                cur[3] = mode
    return res


def display_dialog(parent):
    outs = outputs()
    dlg = Gtk.Dialog(title="Display", transient_for=parent, modal=True)
    dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Apply", Gtk.ResponseType.OK)
    box = dlg.get_content_area()
    box.set_spacing(10)
    box.set_border_width(16)
    if not outs:
        box.add(Gtk.Label(label="No display information available."))
    combos = []
    for name, modes, current, preferred in outs:
        box.add(ui.css(Gtk.Label(label=f"Screen {name}", xalign=0), "f-h2"))
        combo = Gtk.ComboBoxText()
        combo.append("auto", "Automatic (fit to screen / VM window)")
        for m in modes:
            combo.append(m, m.replace("x", " × ") + ("  (recommended)" if m == preferred else ""))
        combo.set_active_id("auto" if not os.path.exists(MANUAL) else (current or "auto"))
        box.add(combo)
        combos.append((name, combo))
    box.add(ui.css(Gtk.Label(label="Tip: in VirtualBox, VMware or Hyper-V choose Automatic and resize the VM window.",
                             xalign=0, wrap=True, max_width_chars=50), "f-muted"))
    dlg.show_all()
    if dlg.run() == Gtk.ResponseType.OK:
        auto = True
        for name, combo in combos:
            mode = combo.get_active_id()
            if mode == "auto":
                subprocess.run(["wlr-randr", "--output", name, "--preferred"])
            else:
                auto = False
                subprocess.run(["wlr-randr", "--output", name, "--mode", mode])
        os.makedirs(os.path.dirname(MANUAL), exist_ok=True)
        if auto:
            if os.path.exists(MANUAL):
                os.remove(MANUAL)
        else:
            open(MANUAL, "w").close()
    dlg.destroy()


TILES = [
    ("Display", "video-display", "display"),
    ("Network & Wi-Fi", "network-wireless", ["nm-connection-editor"]),
    ("Sound", "audio-volume-high", ["pavucontrol"]),
    ("Bluetooth", "bluetooth", ["blueman-manager"]),
    ("Wallpaper", "preferences-desktop-wallpaper", None),
    ("Software & Updates", "system-software-update", ["foundation-store"]),
    ("Install updates now", "software-update-available", ["foundation-updates"]),
    ("Files", "system-file-manager", ["thunar"]),
    ("Terminal", "utilities-terminal", ["foot"]),
    ("System monitor", "utilities-system-monitor", ["foot", "-e", "top"]),
]


def main():
    ui.apply_css()
    if len(sys.argv) > 1 and sys.argv[1] == "wallpaper":
        pick_wallpaper(None)
        return
    if len(sys.argv) > 1 and sys.argv[1] == "display":
        display_dialog(None)
        return
    win = Gtk.Window(title="Foundation Settings")
    win.set_default_size(*ui.fit_size(640, 460))
    win.set_icon_name("foundation")
    win.connect("destroy", Gtk.main_quit)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
    box.set_border_width(18)
    win.add(box)
    box.pack_start(ui.css(Gtk.Label(label="Settings", xalign=0), "f-title"), False, False, 0)
    grid = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=3, min_children_per_line=3,
                       homogeneous=True, row_spacing=10, column_spacing=10)
    for label, icon, cmd in TILES:
        b = ui.css(Gtk.Button(), "f-card")
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG)
        img.set_pixel_size(40)
        v.pack_start(img, False, False, 0)
        v.pack_start(Gtk.Label(label=label), False, False, 0)
        b.add(v)
        if cmd == "display":
            b.connect("clicked", lambda *_: display_dialog(win))
        elif cmd:
            b.connect("clicked", lambda _b, c=cmd: ui.spawn(*c))
        else:
            b.connect("clicked", lambda *_: pick_wallpaper(win))
        grid.add(b)
    box.pack_start(grid, True, True, 0)
    ver = open("/usr/share/foundation/VERSION").read().strip() if os.path.exists("/usr/share/foundation/VERSION") else "?"
    kernel = os.uname().release
    box.pack_start(ui.css(Gtk.Label(label=f"Foundation OS {ver}  ·  Linux {kernel}", xalign=0), "f-muted"),
                   False, False, 0)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
