#!/usr/bin/env python3
"""Stoa Doctor: check this PC for common problems and fix them.

  stoa-doctor            check everything and print the results
  stoa-doctor --json     the same, as JSON (for Stoa AI)
  stoa-doctor fix ID     fix one problem (disk, packages, services, internet, portal, audio, memory, signatures)
  stoa-doctor watch      keep checking in the background and notify about new problems (started at sign-in)
"""
import json
import sys

sys.path.insert(0, "/usr/lib/stoa")
import doctor  # noqa: E402


def main():
    a = sys.argv[1:]
    if a and a[0] in ("-h", "--help"):
        print(__doc__)
    elif a and a[0] == "--json":
        print(json.dumps([{"check": n, "ok": i is None, **(i or {})} for n, i in doctor.run_checks()], indent=1))
    elif a and a[0] == "fix" and len(a) > 1:
        ok, msg = doctor.fix(a[1])
        print(msg)
        sys.exit(0 if ok else 1)
    elif a and a[0] == "watch":
        doctor.watch()
    else:
        for name, issue in doctor.run_checks():
            print(f"{'✗' if issue else '✓'} {name}" + (f": {issue['title']}\n    {issue['detail']}" if issue else ""))


if __name__ == "__main__":
    main()
