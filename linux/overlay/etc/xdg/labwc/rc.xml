<?xml version="1.0"?>
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>6</gap>
  </core>
  <theme>
    <name>Stoa</name>
    <cornerRadius>8</cornerRadius>
    <font place="ActiveWindow"><name>Inter</name><size>10</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>Inter</name><size>10</size><weight>bold</weight></font>
    <font place="MenuItem"><name>Inter</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>Inter</name><size>10</size></font>
  </theme>
  <placement><policy>cascade</policy></placement>
  <focus><followMouse>no</followMouse><raiseOnFocus>no</raiseOnFocus></focus>
  <snapping><range>12</range><topMaximize>yes</topMaximize></snapping>
  <keyboard>
    <default />
    <!-- Stoa shortcuts (Super = the key with the logo between Ctrl and Alt) -->
    <keybind key="W-space"><action name="Execute"><command>stoa-shell start</command></action></keybind>
    <keybind key="C-Escape"><action name="Execute"><command>stoa-shell start</command></action></keybind>
    <keybind key="W-s"><action name="Execute"><command>stoa-shell search</command></action></keybind>
    <keybind key="W-a"><action name="Execute"><command>stoa-shell quick</command></action></keybind>
    <keybind key="W-n"><action name="Execute"><command>stoa-shell calendar</command></action></keybind>
    <keybind key="W-r"><action name="Execute"><command>stoa-shell run</command></action></keybind>
    <keybind key="W-e"><action name="Execute"><command>thunar</command></action></keybind>
    <keybind key="W-c"><action name="Execute"><command>stoa-assistant</command></action></keybind>
    <keybind key="W-i"><action name="Execute"><command>stoa-settings</command></action></keybind>
    <keybind key="W-l"><action name="Execute"><command>stoa-lock</command></action></keybind>
    <keybind key="C-S-Escape"><action name="Execute"><command>gnome-system-monitor</command></action></keybind>
    <keybind key="C-A-Delete"><action name="Execute"><command>gnome-system-monitor</command></action></keybind>
    <keybind key="W-Return"><action name="Execute"><command>foot</command></action></keybind>
    <keybind key="C-A-t"><action name="Execute"><command>foot</command></action></keybind>
    <keybind key="Print"><action name="Execute"><command>stoa-screenshot full</command></action></keybind>
    <keybind key="W-S-s"><action name="Execute"><command>stoa-screenshot area</command></action></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute"><command>wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+</command></action></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute"><command>wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-</command></action></keybind>
    <keybind key="XF86AudioMute"><action name="Execute"><command>wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle</command></action></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute"><command>brightnessctl set 5%+</command></action></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute"><command>brightnessctl set 5%-</command></action></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-Down"><action name="Iconify" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
  </keyboard>
  <mouse>
    <default />
  </mouse>
  <libinput>
    <device category="touchpad"><naturalScroll>yes</naturalScroll><tap>yes</tap></device>
  </libinput>
</labwc_config>
