#!/usr/bin/env python3
"""Stoa Task Manager: what's running, how hard the PC is working, start-up apps, and everything in this PC.

  stoa-taskmgr                         open on Processes (Ctrl+Shift+Esc)
  stoa-taskmgr performance|startup|health|system
  stoa-taskmgr --report                print the hardware report (for Stoa AI and for support)
  stoa-taskmgr --autostart             start the apps set to start when you sign in (run by the session)
"""
