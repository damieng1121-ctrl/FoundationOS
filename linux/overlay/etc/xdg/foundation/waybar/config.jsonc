{
  "layer": "top",
  "position": "bottom",
  "height": 44,
  "spacing": 4,
  "modules-left": ["image#logo", "custom/start", "wlr/taskbar"],
  "modules-right": ["custom/install", "custom/updates", "tray", "network", "pulseaudio", "battery", "clock"],

  "image#logo": {
    "path": "/usr/share/foundation/logo-white-64.png",
    "size": 22,
    "on-click": "foundation-launcher",
    "tooltip": false
  },
  "custom/start": {
    "format": "Foundation",
    "on-click": "foundation-launcher",
    "tooltip": false
  },
  "wlr/taskbar": {
    "format": "{icon} {title:.22}",
    "icon-size": 20,
    "on-click": "activate",
    "on-click-middle": "close",
    "tooltip-format": "{title}",
    "ignore-list": ["foundation-launcher"]
  },
  "custom/install": {
    "exec": "/usr/lib/foundation/live-status",
    "return-type": "json",
    "interval": "once",
    "on-click": "foundation-installer"
  },
  "custom/updates": {
    "exec": "fpkg updates --waybar",
    "return-type": "json",
    "interval": 1800,
    "signal": 8,
    "on-click": "foundation-updates"
  },
  "tray": { "spacing": 8, "icon-size": 18 },
  "network": {
    "format-wifi": "📶 {essid}",
    "format-ethernet": "🖧 Wired",
    "format-disconnected": "⚠ Offline",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) - {ipaddr}",
    "tooltip-format-ethernet": "{ifname} - {ipaddr}",
    "on-click": "nm-connection-editor"
  },
  "pulseaudio": {
    "format": "🔊 {volume}%",
    "format-muted": "🔇",
    "on-click": "pavucontrol",
    "scroll-step": 5
  },
  "battery": { "format": "🔋 {capacity}%", "format-charging": "⚡ {capacity}%" },
  "clock": {
    "format": "{:%H:%M  ·  %a %d %b}",
    "tooltip-format": "<tt>{calendar}</tt>"
  }
}
